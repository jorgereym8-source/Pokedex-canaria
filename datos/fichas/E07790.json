{"codigo":"E07790","nombre":"Chenopodium probstii","autor":"Aellen","rango":"especie","nombreCompleto":"Chenopodium probstii Aellen","comunes":[],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Magnoliopsida","validez":"Válido","status":"Actual","presencia":{"P":"s","T":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/E07790"},"imagenes":[],"mapaPk":"108560625","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":false,"especie":false,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"D03441"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Caryophyllales","Familia":"Amaranthaceae","Género":"Chenopodium"},"sinonimos":0,"referencias":4,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":6035638,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/6035638","iucnId":null},"forma":{"valor":"hierba","fuente":"Wikipedia (es)"},"fotosLibres":[{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos