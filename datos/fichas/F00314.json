narias":{"género":false,"especie":true,"subespecie":null},"macaronesia":{"género":null,"especie":true,"subespecie":null}},"origen":{"nombre":"Nativo Seguro","codigo":"NS","definicion":"Incluye taxones nativos, tanto endémicos como no endémicos. En ambos casos esta categoría será asignada a aquellos taxones de los que se tiene constancia o se intuye que su presencia en Canarias es natural y no asociada a la actividad humana.","documento":"F01114"},"habitats":[],"protegida":true,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Caryophyllales","Familia":"Plumbaginaceae","Género":"Limonium"},"sinonimos":8,"referencias":53,"proteccion":{"Catálogo Canario":{"Fuerteventura":{"categoria":"Interés para los ecosistemas canarios","definicion":"El Catálogo Canario de Especies Protegidas incluirá, asimismo, especies \"de interés para los ecosistemas canarios\", que son aquellas que, sin estar en ninguna de las dos situaciones de amenaza del apartado anterior, sean merecedoras de atención particular por su importancia ecológica en espacios de la Red Canaria de Espacios Naturales Protegidos o de la Red Natura 2000. Tendrán la consideración de especies de \"interés para los ecosistemas canarios\" las enumeradas en el anexo III de la presente ley y las que se designen conforme a los criterios previstos en el artículo 6 de la presente ley."},"Lanzarote":{"categoria":"Interés para los ecosistemas canarios","definicion":"El Catálogo Canario de Especies Protegidas incluirá, asimismo, especies \"de interés para los ecosistemas canarios\", que son aquellas que, sin estar en ninguna de las dos situaciones de amenaza del apartado anterior, sean merecedoras de atención particular por su importancia ecológica en espacios de la Red Canaria de Espacios Naturales Protegidos o de la Red Natura 2000. Tendrán la consideración de especies de \"interés para los ecosistemas canarios\" las enumeradas en el anexo III de la presente ley y las que se designen conforme a los criterios previstos en el artículo 6 de la presente ley."}}},"enlaces":[{"titulo":"Ministerio de Transición Ecológica. Libros Rojos","url":"http://www.magrama.gob.es/en/biodiversidad/temas/inventarios-nacionales/1028_tcm11-149610.pdf"},{"titulo":"GBIF-España. Global Biodiversity Information Facility","url":"http://www.gbif.org/species/4090703"}],"gbifId":"4090703","centinela":{"secciones":{"Distribución mundial":"Endemismo canario.","Distribución en Canarias":"Norte de Lanzarote.","Origen":"Nativo Seguro (NS)","Hábitat":"Crece en andenes y riscos, eriales, en laderas de barranco de zonas elevadas, a parir de los 250 m (Bañares, A., et al., 2004).","Claves de identificación":"Planta de pequeño tamaño, de 10 a 15 cm. de altura, muy ramificada y de base leñosa. Sus hojas tienen forma avalado-romboidal, pecíolo corto y están cubiertas de pequeños pelos. Presenta inflorescencias pequeñas y los tallos floríferos y los pedúnculos no son alados. Se diferencia de L. bourgeauii por tener las hojas más pequeñas, el pecíolo y el tallo floral más corto y no alado (González González, R., et al.,2010)."},"pdf":true},"nivel":"canario","actualizado":"2026-11-21","gbifClave":4090703,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/4090703","iucnId":null},"tamano":{"min":0.1,"max":0.15,"tipo":"altura","cita":"Planta de pequeño tamaño, de 10 a 15 cm","fuente":"Centinela (claves de identificación)","url":"https://www.biodiversidadcanarias.es/centinela/especie/F00314"},"ciclo":{"valor":"Perenne","fuente":"Centinela"},"forma":{"valor":"hierba","fuente":"Wikipedia (es)"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Limonium puberulum.jpg","autor":"Keops29","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","pagina":"https://commons.wikimedia.org/wiki/File:Limonium_puberulum.jpg","nivel":"taxon"},{"fue