{"codigo":"A06041","nombre":"Halophiloscia couchii","autor":"(Kinahan, 1858)","rango":"especie","nombreCompleto":"Halophiloscia couchii (Kinahan, 1858)","comunes":["Cochinita de Couch"],"reino":"Fauna","grupo":"Crustáceos","subgrupo":"Cochinillas de la humedad y afines","medio":"Terrestre","clase":"Malacostraca","validez":"Válido","status":"Actual","presencia":{"P":"s","T":"s","C":"s","F":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/A06041"},"imagenes":[],"mapaPk":"2865","comunTitulo":"Cochinita de Couch","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":null,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"A02284"},"habitats":[{"categoria":"Medio hipógeo","documento":"A01828"},{"categoria":"Medio hipógeo exclusivamente","documento":"A02314"}],"protegida":false,"taxonomia":{"Reino":"Metazoa","Filo":"Arthropoda","Clase":"Malacostraca","Orden":"Isopoda","Familia":"Halophilosciidae","Género":"Halophiloscia"},"sinonimos":5,"referencias":18,"proteccion":{},"enlaces":[],"actualizado":"2026-11-22","nivel":"introducido","gbifClave":2207630,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/