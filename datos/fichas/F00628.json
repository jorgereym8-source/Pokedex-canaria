{"codigo":"F00628","nombre":"Trifolium obscurum","autor":"Savi","rango":"especie","nombreCompleto":"Trifolium obscurum Savi","comunes":["Trébol oscuro"],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Magnoliopsida","validez":"Válido","status":"Actual","presencia":{"G":"s","C":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F00628"},"imagenes":[],"mapaPk":"9240","comunTitulo":"Trébol oscuro","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":false,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"D03441"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Fabales","Familia":"Fabaceae","Género":"Trifolium"},"sinonimos":8,"referencias":8,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":5358715,"uicn":{"codigo":"LC","categoria":"Preocupación menor","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/5358715","iucnId":"19891790"},"forma":{"valor":"planta","fuente":"Familia o tamaño"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Contributio