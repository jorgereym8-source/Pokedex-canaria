url":"https://inaturalist-open-data.s3.amazonaws.com/photos/154769884/medium.jpg","autor":"Sune Holt","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/154769884","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/462599007/medium.jpg","autor":"Marco Polo amarillas vargas","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/462599007","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/13669688/medium.jpg","autor":"Young Chan","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/13669688","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/110372064/medium.jpeg","autor":"葉子","lic":"CC0","licUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.es","pagina":"https://www.inaturalist.org/photos/110372064","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/introducidas/ocimum-basilicum","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["China","Asia oriental","subcontinente indio","Indochina","Malesia","Papuasia","Australia"],"introducida":["norte de Europa","centro de Europa","sureste de Europa","este de Europa","Macaronesia","África tropical occidental","África tropical centro-occidental","África tropical nororiental","África tropical oriental","África tropical meridional","sur de África","oeste del Índico","Lejano Oriente ruso","Central Asia","oeste de Asia","península arábiga","China","Mongolia","subcontinente indio","Malesia","Australia","Pacífico suroeste","Pacífico centro-sur","Pacífico noroeste","Pacífico centro-norte","centro-norte de EE. UU.","noreste de EE. UU.","México","Centroamérica","Caribe","norte de Sudamérica","oeste de Sudamérica","Brasil"],"nAreasNativa":28,"nAreasIntroducida":102,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:452874-1","nivel":"taxon","nombre":null},"etimologia":{"texto":"El nombre del género Ocimum proviene de la palabra griega ókimon, que significa labio perfumado u oloroso, por  el olor de sus hojas. El epíteto basilicum procede del griego basilikon o basiléus  que significa real o regio. En cuanto al arabismo albahaca o albaca, proviene del árabe hispánico alḥabáqa (الحبق), y este del árabe clásico ḥabaqah, formado de la partícula ال (al = el o la) y la palabra حبق (habaqa), nombre que les daban los árabes a las plantas aromáticas usadas en la cocina y medicina.[cita requerida]\nPor su parte, la palabra basílico viene del latín basilius, y el griego βασιλικόν φυτόν (basilikón phytón), que significa \"planta real\", posiblemente porque se creía que la planta se había utilizado en la producción de perfumes reales.","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Ocimum_basilicum"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"anual o subarbusto","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:452874-1"},{"grupo":"Forma de vida","k":"Clima","v":"tropical estacionalmente seco","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:452874-1"}],"altitud":{"p5":10,"p95":190,"min":10,"max":200,"n":9,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?taxon_key=2927096&geometry=POLYGON((-18.5 27.4,-13.2 27.4,-13.2 29.5,-18.5 29.5,-18.5 27.4))"},"primerRegistro":{"ano":2012,"tipo":"observación","url":"https://www.gbif.org/occurrence/5025815900","fuente":"GBIF"}}