pg","autor":"MPF","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","pagina":"https://commons.wikimedia.org/wiki/File:Dipsacus_fullonum1.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/4868851/medium.jpg","autor":"Andreas Rockstein","lic":"CC BY-SA","licUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/4868851","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/8611124/medium.jpg","autor":"Doug Grinbergs","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/8611124","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/106608733/medium.jpeg","autor":"learmonj","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/106608733","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/324280898/medium.jpg","autor":"Maite Etchevarne","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/324280898","nivel":"taxon"}],"mundo":{"nativa":["norte de Europa","centro de Europa","suroeste de Europa","sureste de Europa","este de Europa","norte de África","Cáucaso","oeste de Asia"],"introducida":["norte de Europa","este de Europa","Macaronesia","Siberia","Australia","Nueva Zelanda","oeste de Canadá","este de Canadá","noroeste de EE. UU.","centro-norte de EE. UU.","noreste de EE. UU.","suroeste de EE. UU.","centro-sur de EE. UU.","sureste de EE. UU.","oeste de Sudamérica","sur de Sudamérica"],"nAreasNativa":35,"nAreasIntroducida":63,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:319260-1","nivel":"taxon","nombre":null},"etimologia":{"texto":"Dipsacus: nombre genérico que deriva del griego dípsakos; latinizado dipsacos  = en Dioscórides y Plinio, planta de tallos y hojas espinosas, y flores reunidas en cabezuelas espinosas, semejantes al erizo. Sin duda, se trata de las cardenchas –varias especies del género Dipsacus L. (Dipsacaceae), principalmente D. fullonum L.–. Según Dioscórides, en la versión de Laguna, “las hojas luengas, espinosas [...] las quales de dos en dos abraçan el dicho tallo por cada juntura, ò nudo, haziendo con sus partes baxas (con las que se juntan) ciertas concavidades, en que se recoja y reciba la lluvia, ò rocio, de do vino esta planta a llamarse Dipsacos, que quiere dezir sedienta” –gr. dípsa, = \"sed\".​\nfullonum: epíteto latino que refiere al cardar la lana (\"de los cardadores\").​","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Dipsacus_fullonum"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"bienal o perenne","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:319260-1"},{"grupo":"Forma de vida","k":"Clima","v":"templado","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:319260-1"}],"primerRegistro":{"ano":2019,"tipo":"observación","url":"https://www.gbif.org/occurrence/3952472318","fuente":"GBIF"}}