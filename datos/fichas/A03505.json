{"codigo":"A03505","nombre":"Stomoxys calcitrans","autor":"(Linnaeus, 1758)","rango":"especie","nombreCompleto":"Stomoxys calcitrans (Linnaeus, 1758)","comunes":["Mosca picona"],"reino":"Fauna","grupo":"Insectos","subgrupo":"Dípteros","medio":"Terrestre","clase":"Hexapoda","validez":"Válido","status":"Actual","presencia":{"H":"s","P":"s","G":"s","T":"s","C":"s","F":"s","L":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/A03505"},"imagenes":[],"mapaPk":"6028","comunTitulo":"Mosca picona","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":null,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"A02090"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Metazoa","Filo":"Arthropoda","Clase":"Hexapoda","Orden":"Diptera","Familia":"Muscidae","Género":"Stomoxys"},"sinonimos":0,"referencias":24,"proteccion":{},"enlaces":[],"actualizado":"2026-11-22","nivel":"introducido","gbifClave":1526081,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/1526081","iucnId":null},"tamano":{"min":0.006,"max":0.008,"tipo":"longitud","cita":"Menor tamaño, y al observarse de cerca tiene un abdomen ligeramente más