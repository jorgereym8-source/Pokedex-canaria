{"codigo":"F00507","nombre":"Lathyrus cicera","autor":"L.","rango":"especie","nombreCompleto":"Lathyrus cicera L.","comunes":["Chícharo cicérula"],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Magnoliopsida","validez":"Válido","status":"Actual","presencia":{"H":"s","P":"s","C":"s","L":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F00507"},"imagenes":[],"mapaPk":"10046","comunTitulo":"Chícharo cicérula","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":false,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"F01114"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Fabales","Familia":"Fabaceae","Género":"Lathyrus"},"sinonimos":0,"referencias":13,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":5356481,"uicn":{"codigo":"LC","categoria":"Preocupación menor","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/5356481","iucnId":"174708"},"tamano":{"min":null,"max":1.0,"tipo":"altura","cita":"Tallos de hasta 1 m, generalmente alados","fuente":"Wi