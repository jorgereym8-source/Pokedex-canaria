{"codigo":"A05571","nombre":"Peregrinus maidis","autor":"(Ashmead, 1890)","rango":"especie","nombreCompleto":"Peregrinus maidis (Ashmead, 1890)","comunes":[],"reino":"Fauna","grupo":"Insectos","subgrupo":"Hemípteros","medio":"Terrestre","clase":"Hexapoda","validez":"Válido","status":"Actual","presencia":{"T":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/A05571"},"imagenes":[],"mapaPk":"3219","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":null,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"D03257"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Metazoa","Filo":"Arthropoda","Clase":"Hexapoda","Orden":"Hemiptera","Familia":"Delphacidae","Género":"Peregrinus"},"sinonimos":0,"referencias":7,"proteccion":{},"enlaces":[],"actualizado":"2026-11-22","nivel":"introducido","gbifClave":5156453,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/5156453","iucnId":null},"tamano":{"min":null,"max":0.002,"tipo":"longitud","cita":"Maidis presenta dimorfismo sexual en el tamaño del cuerpo entre machos y hembras.​ Los machos tienen una longitud corporal de 2 mm con una envergadura de 6 mm, m