num"},"ciclo":{"valor":"Perenne","fuente":"Wikipedia (es)"},"forma":{"valor":"hierba","fuente":"Wikipedia (es)"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Hypericum glandulosum 01.jpg","autor":"Patrice78500","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","pagina":"https://commons.wikimedia.org/wiki/File:Hypericum_glandulosum_01.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/204052938/medium.jpeg","autor":"inesalvar","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/204052938","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/179370555/medium.jpeg","autor":"Vítor Jorge","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/179370555","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/207655020/medium.jpeg","autor":"Alex","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/207655020","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/58875603/medium.jpg","autor":"underm01","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/58875603","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/endemic-canarias-macaronesia/endemic-canarias-macaronesia/hypericum-glandulosum","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["Canarias","Madeira"],"introducida":[],"nAreasNativa":2,"nAreasIntroducida":0,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:433458-1","nivel":"taxon","nombre":null},"etimologia":{"texto":"Hipérico: nombre genérico que deriva del griego hyperikon (\"sobre las imágenes\" o \"por encima de una aparición\"). Para algunos, el nombre hace referencia a la propiedad que se le atribuía de hacer huir a los malos espíritus y las apariciones; solían colgarse flores de esta planta sobre las imágenes religiosas el día de San Juan. Para otros, las glándulas de sus pétalos parecen formar imágenes (a este hecho se le dio mucha importancia en la Edad Media, ya que era utilizado en los exorcismos por sus virtudes cabalísticas). \nmontanum: epíteto latino que significa \"de las montañas\".","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Hypericum_montanum"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"subarbusto o arbusto","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:433458-1"},{"grupo":"Forma de vida","k":"Clima","v":"subtropical","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:433458-1"},{"grupo":"Genética","k":"Número cromosomático","v":"2n = 18","fuente":"CCDB","url":"https://ccdb.tau.ac.il/search/?genus=Hypericum"}],"altitud":{"p5":280,"p95":1020,"min":100,"max":2330,"n":129,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?taxon_key=8332804&geometry=POLYGON((-18.5 27.4,-13.2 27.4,-13.2 29.5,-18.5 29.5,-18.5 27.4))"}}