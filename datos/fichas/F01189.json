{"codigo":"F01189","nombre":"Echium simplex","autor":"DC.","rango":"especie","nombreCompleto":"Echium simplex DC.","comunes":["Taginaste simple","arrebol"],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Magnoliopsida","validez":"Válido","status":"Actual","presencia":{"H":"t","P":"t","G":"t","T":"s","C":"t"},"origenCsv":"NS","endemicoCsv":true,"nImagenes":2,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F01189","centinela":"https://www.biodiversidadcanarias.es/centinela/especie/F01189"},"imagenes":[{"id":"189661328","autor":"","licencia":"","documento":"D03614","portada":false,"descripcion":"","credito":"García-Casanova, G., 2020"},{"id":"189661329","autor":"","licencia":"","documento":"D03614","portada":false,"descripcion":"","credito":"García-Casanova, G., 2020"}],"mapaPk":"10401","comunTitulo":"Taginaste simple, arrebol,","endemicidad":{"canarias":{"género":false,"especie":true,"subespecie":null},"macaronesia":{"género":false,"especie":true,"subespecie":null}},"origen":{"nombre":"Nativo Seguro","codigo":"NS","definicion":"Incluye taxones nativos, tanto endémicos como no endémicos. En ambos casos esta categoría será asignada a aquellos taxones de los que se tiene constancia o se intuye que su presencia en Canarias es natural y no asociada a la actividad humana.","documento":"F01114"},"habitats":[],"protegida":true,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Boraginales","Familia":"Boraginaceae","Género":"Echium"},"sinonimos":0,"referencias":80,"proteccion":{"Orden de Flora":{"Tenerife":{"categoria":"Anexo II","definicion":"Las especies incluidas en este anexo se declaran protegidas."}}},"enlaces":[],"centinela":{"secciones":{"Distribución mundial":"Especie muy apreciada desde el punto de vista ornamental que se cultiva en numerosos jardines botánicos. Actualmente se cultiva en el Jardín Botánico Canario Viera y Clavijo de Las Palmas de Gran Canaria y en el Jardín Botánico Marimurtra de Blanes en Girona entre otros. Se ha localizado asilvestrada a partir de cultivos de jardinería en la zona norte de El Hierro, en algunos puntos de La Gomera, en varias localidades de La Palma, Gran Canaria y Tenerife. Se ha reseñado como naturalizada en el sur de Australia y Sudáfrica.","Origen":"Nativo Seguro (NS)"},"pdf":true},"nivel":"canario","actualizado":"2026-11-21","gbifClave":4067782,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/4067782","iucnId":null},"tamano":{"min":1.0,"max":3.0,"tipo":"altura","cita":"Desarrolla inflorescencia erecta que puede alcanzar de 1 a 3 metros, durante el segundo año","fuente":"Wikipedia (es)","url":"https://es.wikipedia.org/wiki/Echium_simplex"},"ciclo":{"valor":"Bienal","fuente":"Wikipedia (es)"},"forma":{"valor":"roseta","fuente":"Wikipedia (es)"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Echium simplex k2.jpg","autor":"H.-U. Küenle","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","pagina":"https://commons.wikimedia.org/wiki/File:Echium_simplex_k2.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/63594718/medium.jpg","autor":"lallen","lic":"CC0","licUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.es","pagina":"https://www.inaturalist.org/photos/63594718","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/109217583/medium.jpeg","autor":"sergioc","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/109217583","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/201237802/medium.jpeg","autor":"Konrad and Roland Greinwald","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/201237802","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/endemicas/tenerife/echium-simplex","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["Canarias"],"introducida":["Macaronesia","sur de África","islas del Atlántico central"],"nAreasNativa":1,"nAreasIntroducida":4,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:115892-1","nivel":"taxon","nombre":null},"etimologia":{"texto":"Echium: nombre genérico que deriva del griego echion, derivado de echis que significa víbora, por la forma triangular de las semillas que recuerda vagamente a la cabeza de una víbora.​\nsimplex: epíteto latino que significa 'simple, sencillo o no compuesto', y que alude a la ausencia de ramificación en los tallos.​","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Echium_simplex"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"bienal o subarbusto","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:115892-1"},{"grupo":"Forma de vida","k":"Clima","v":"subtropical","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:115892-1"}],"altitud":{"p5":60,"p95":770,"min":0,"max":1220,"n":149,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?taxon_key=4067782&geometry=POLYGON((-18.5 27.4,-13.2 27.4,-13.2 29.5,-18.5 29.5,-18.5 27.4))"}}