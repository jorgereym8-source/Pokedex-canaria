{"codigo":"F01652","nombre":"Podospermum laciniatum","autor":"(L.) DC.","rango":"especie","nombreCompleto":"Podospermum laciniatum (L.) DC.","comunes":["Barrajas"],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Magnoliopsida","validez":"Válido","status":"Actual","presencia":{"T":"s","C":"s","F":"s","L":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":1,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F01652"},"imagenes":[{"id":"252903903","autor":"","licencia":"","documento":"P01929","portada":false,"descripcion":"","credito":"Sauerbier, H., 2023"}],"mapaPk":"11042","comunTitulo":"Barrajas","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":false,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"F01114"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Asterales","Familia":"Asteraceae","Género":"Podospermum"},"sinonimos":14,"referencias":20,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":8286501,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/8286501","iucnId":null},"ciclo":{"valor":"Monocárpica (florece una vez y muere)","fuente":"Wikipedia (es)"},"forma":{"valor":"hierba","fuente":"Wikipedia (es)"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Scorzonera laciniata eF.jpg","autor":"Fornax","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","pagina":"https://commons.wikimedia.org/wiki/File:Scorzonera_laciniata_eF.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/34477970/medium.jpg","autor":"Craig Martin","lic":"CC0","licUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.es","pagina":"https://www.inaturalist.org/photos/34477970","nivel":"sinonimo","taxon":"Scorzonera laciniata"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/127649054/medium.jpg","autor":"alina_snbn","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/127649054","nivel":"sinonimo","taxon":"Scorzonera laciniata"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/43039673/medium.jpeg","autor":"Nathan Taylor","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/43039673","nivel":"sinonimo","taxon":"Scorzonera laciniata"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/3340947/medium.jpg","autor":"ellen hildebrandt","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/3340947","nivel":"sinonimo","taxon":"Scorzonera laciniata"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/introducidas/podospermum-laciniatum-scorzonera-laciniata","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["centro de Europa","suroeste de Europa","sureste de Europa","este de Europa","Macaronesia","Central Asia","Cáucaso","oeste de Asia","subcontinente indio"],"introducida":["Australia","noroeste de EE. UU.","centro-norte de EE. UU.","centro-sur de EE. UU."],"nAreasNativa":33,"nAreasIntroducida":10,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:243258-1","nivel":"taxon","nombre":"Scorzonera laciniata"},"etimologia":{"texto":"Podospermum: vocablo compuesto por el prefijo de origen griego πoδo, de πoύς, -δoς, pie, y σπερμα, -αtoς, semilla, o sea «semilla con pié», por la cipsela que tiene un notable pedicelo en su parte inferior.\nlaciniatum: derivado del latín lǎcǐnǐōsus, -a, -um, dividido en segmentos, recortado, de lācǐnǐa (del griego λαχίς), trozo de vestido, o sea «laciniado», por las hojas generalmente divididas en estrechos lóbulos.","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Podospermum_laciniatum"},"rasgos":[{"grupo":"Forma de vida","k":"Clima","v":"templado","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:243258-1"}],"primerRegistro":{"ano":2024,"tipo":"observación","url":"https://www.gbif.org/occurrence/6133192222","fuente":"GBIF"}}