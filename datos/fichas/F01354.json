rotegida":true,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Lamiales","Familia":"Lamiaceae","Género":"Sideritis"},"sinonimos":5,"referencias":53,"proteccion":{"Catálogo Español/LESRPE":{"La Gomera":{"categoria":"Régimen de protección especial","definicion":"Especies, subespecies y poblaciones que sean merecedoras de una atención y protección particular en función de su valor científico, ecológico, cultural, por su singularidad, rareza, o grado de amenaza, así como aquellas que figuren como protegidas en los anexos de las Directivas y los convenios internacionales ratificados por España."}},"Directiva Hábitat":{"La Gomera":{"categoria":"Anexo II y IV","definicion":"Especies que se encuentran incluidas en ambas categorías. Según el Anexo II, son especies cuyos hábitats requieren designación de ZEC; y según el Anexo IV: son especies que requieren protección estricta."}},"Catálogo Canario":{"La Gomera":{"categoria":"En peligro de extinción","definicion":"Especies \"en peligro de extinción\", que serán, aparte de aquellas con presencia significativa en Canarias y así calificadas por el Catálogo Español de Especies Amenazadas, las que se incorporen de acuerdo con lo previsto en la presente ley o figuren en su anexo I, constituidas por taxones o poblaciones cuya supervivencia es poco probable si los factores causales de su actual situación siguen actuando."}},"Convenio de Berna":{"La Gomera":{"categoria":"Anejo I","definicion":"Especies de flora estrictamente protegida"}}},"enlaces":[{"titulo":"Sexenal 2001-2006","url":"http://cdr.eionet.europa.eu/Converters/run_conversion?file=/es/eu/art17/envshhaew/species-sideritis-marmorea.xml&conv=24&source=remote#MAC"},{"titulo":"Sexenal 2007-2012","url":"http://cdr.eionet.europa.eu/Converters/run_conversion?file=/es/eu/art17/envucgusw/ES_species_reports-13910-125043.xml&conv=354&source=remote#1704"},{"titulo":"Sexenal 2013-2018","url":"https://cdr.eionet.europa.eu/Converters/run_conversion?file=es/eu/art17/envxrm14a/ES_species_reports-20190723-144539.xml&conv=593&source=remote#1704"},{"titulo":"Ministerio de Transición Ecológica. Libros Rojos","url":"http://www.magrama.gob.es/es/biodiversidad/temas/inventarios-nacionales/749_tcm7-149497.pdf"},{"titulo":"UICN. Unión Internacional para la Conservación de la Naturaleza","url":"http://www.iucnredlist.org/details/162240/0"},{"titulo":"GBIF-España. Global Biodiversity Information Facility","url":"https://www.gbif.org/species/3889964"}],"uicnId":"162240","gbifId":"3889964","centinela":{"secciones":{"Distribución mundial":"Endemismo canario.","Distribución en Canarias":"Este de La Gomera.","Origen":"Nativo Seguro (NS)","Hábitat":"Forma parte de las comunidades que se asientan en riscos de gran pendiente, en áreas propias del tabaibal-cardonal. (Beltrán et al., 1999)","Claves de identificación":"Arbusto de hasta 60 cm de alto. Ramas y tallos jóvenes densamente pelosos. Hojas de anchamente ovaladas a arriñonadas, de borde ondulado, redondeadas en el ápice, acorazonadas en la base, con pecíolos largos, recubiertas de pelos cortos densos y de color verde grisáceo o verde amarillento en el haz, blanco-amarillentas en el envés. Inflorescencias ramificadas. Cáliz con dientes obtusos. Corola blanco-amarillenta. Se diferencia de otras especies del género por sus hojas largamente pecioladas, de forma ovaladas o arriñonadas, acorazonadas en la base y sin pelos estrellados, por sus ramas florales cortas y por sus cálices de dientes obtusos. (Mesa, R. & R. Paredes, 2013)"},"pdf":true},"nivel":"insular","actualizado":"2026-11-21","gbifClave":3889964,"uicn":{"codigo":"CR","categoria":"En peligro crítico","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/3889964","iucnId":"162240"},"tamano":{"min":null,"max":0.6,"tipo":"altura","cita":"Arbusto de hasta 60 cm de alto","fuente":"Centinela (claves de identificación)","url":"https://w