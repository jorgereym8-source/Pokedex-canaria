ulo":"Pico paloma, hierba de plata","endemicidad":{"canarias":{"género":false,"especie":true,"subespecie":null},"macaronesia":{"género":false,"especie":true,"subespecie":null}},"origen":{"nombre":"Nativo Seguro","codigo":"NS","definicion":"Incluye taxones nativos, tanto endémicos como no endémicos. En ambos casos esta categoría será asignada a aquellos taxones de los que se tiene constancia o se intuye que su presencia en Canarias es natural y no asociada a la actividad humana.","documento":"F01114"},"habitats":[{"categoria":"Pinar","documento":"F00039"},{"categoria":"Escarpes rocosos","documento":"F00039"}],"protegida":true,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Fabales","Familia":"Fabaceae","Género":"Lotus"},"sinonimos":8,"referencias":55,"proteccion":{"Catálogo Español/LESRPE":{"Tenerife":{"categoria":"En peligro de extinción","definicion":"Taxones o poblaciones cuya superviviencia es poco probable si los factores causales de su actual situación siguen actuando."}},"Catálogo Canario":{"Tenerife":{"categoria":"En peligro de extinción","definicion":"Especies \"en peligro de extinción\", que serán, aparte de aquellas con presencia significativa en Canarias y así calificadas por el Catálogo Español de Especies Amenazadas, las que se incorporen de acuerdo con lo previsto en la presente ley o figuren en su anexo I, constituidas por taxones o poblaciones cuya supervivencia es poco probable si los factores causales de su actual situación siguen actuando."}}},"enlaces":[{"titulo":"Planes de Recuperación y/o Conservación","url":"http://www.gobiernodecanarias.org/boc/2007/074/007.html"},{"titulo":"Ministerio de Transición Ecológica. Libros Rojos","url":"http://www.magrama.gob.es/es/biodiversidad/temas/inventarios-nacionales/830_tcm7-149524.pdf"},{"titulo":"GBIF-España. Global Biodiversity Information Facility","url":"http://www.gbif.org/species/5356822"}],"gbifId":"5356822","centinela":{"secciones":{"Distribución mundial":"Endemismo canario.","Distribución en Canarias":"Norte y Sur de Tenerife.","Origen":"Nativo Seguro (NS)","Hábitat":"Planta aparentemente rupícola que se desarrolla en matorrales aclarados en territorio del pinar (Gómez et al., 1996)","Claves de identificación":"Arbusto rastrero, de aspecto cinéreo, con tallos leñosos en la base, y numerosas ramas extendidas o péndulas. Presenta hojas compuestas lineares, de color verde-grisáceo, muy numerosas a lo largo de las ramas. Flores reunidas en grupos de 2 a 6, de un intenso color rojo a veces con el estandarte coloreado de anaranjado o incluso amarillento. Se diferencia de Lotus maculatus sobre todo en el tamaño y forma de las hojas que son más cortas y anchas en este último y en el color de las flores que son amarillas. De Lotus eremiticus se diferencia claramente por tener este último las hojas más cortas y anchas (semejantes a las de L. maculatus). (Mesa, R., 2007)"},"pdf":true},"nivel":"insular","actualizado":"2026-11-21","gbifClave":5356822,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/5356822","iucnId":null},"ciclo":{"valor":"Perenne","fuente":"Centinela"},"forma":{"valor":"arbusto","fuente":"Centinela"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Lotus berthelotii IMGP5869.jpg","autor":"Juanillo1976","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","pagina":"https://commons.wikimedia.org/wiki/File:Lotus_berthelotii_IMGP5869.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/269504371/medium.jpg","autor":"Steve Dew","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/269504371","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/211571697/medium.jpeg","aut