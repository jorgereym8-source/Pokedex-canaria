nas","documento":"F00092"}],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Lamiales","Familia":"Acanthaceae","Género":"Acanthus"},"sinonimos":0,"referencias":32,"proteccion":{},"enlaces":[{"titulo":"Compendio de fichas de la Base de Especies Introducidas en Canarias (2008-2011)","url":"https://www.gobiernodecanarias.org/medioambiente/descargas/publicaciones/GOBCAN-2022-Compendio-fichas-especies-introducidas-2008-2011.zip"}],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":5415455,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/5415455","iucnId":null},"tamano":{"min":0.3,"max":0.7,"tipo":"altura","cita":"Hierba perenne de 30–70 cm de altura, más o menos pelosa o glabra, y con un tallo simple, erecto y escaposo.","fuente":"Wikipedia (es)","url":"https://es.wikipedia.org/wiki/Acanthus_mollis"},"ciclo":{"valor":"Perenne","fuente":"Wikipedia (es)"},"forma":{"valor":"hierba","fuente":"Wikipedia (es)"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Acanthaceae - Acanthus mollis (2).JPG","autor":"Hectonichus","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","pagina":"https://commons.wikimedia.org/wiki/File:Acanthaceae_-_Acanthus_mollis_(2).JPG","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/8352674/medium.jpeg","autor":"James Bailey","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/8352674","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/135393284/medium.jpg","autor":"Ben Zerante","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/135393284","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/introducidas/acanthus-mollis","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["suroeste de Europa","sureste de Europa","norte de África","oeste de Asia"],"introducida":["norte de Europa","centro de Europa","suroeste de Europa","sureste de Europa","Macaronesia","Australia","Nueva Zelanda","suroeste de EE. UU.","México"],"nAreasNativa":12,"nAreasIntroducida":20,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:44892-1","nivel":"taxon","nombre":null},"etimologia":{"texto":"Acanthus: del Latín acanthus que proviene del griego ἄκανθα, -ης, \"planta espinosa\", probablemente por composición entre acer, -cris de aceo, acies, \"punzante\" y anthos, \"flor\", del Griego άκτς y άνθός. Virgilio emplea el vocablo en las Geórgicas (4, 123) y Plinio el Viejo describe 2 especies en su historia naturalis (22, XXXIV, 76): el Acanthus spinosus L. y el Acanthus mollis L.; esta última se denomina también paederos y mélamphyllos, y su raíz es excelente para las quemaduras y las luxaciones (\"quod aliqui paederota vocant, alii melamphyllum. huius radices ustis luxatisque mire prosunt\").\nmollis, -e: epíteto Latino que significa \"flexible, blando, tierno,...\".\nSinónimos\nAcanthus mollis subsp. platyphyllus Murb.\nAcanthus mollis var. nigra (Mill.) Willd.\nAcanthus mollis var. viciosoi Pau\nAcanthus latifolius hort.,\nAcanthus lusitanicus hort.,\nAcanthus nigra Mill.\nAcanthus hispanicus Loudon\nAcanthus longifolius Poir.\nAcanthus niger Mill.\nAcanthus platyphyllus Murb.\nAcanthus spinosissimus Host","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Acanthus_mollis"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"perenne","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:44892-1"},{"grupo":"Forma de vida","k":"Clima","v":"templado","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:44892-1"}],"introduccion":{"fecha":"Durante el siglo XIX.","via":"Introducida por su valor ornamental.","dispersion":"Dispersión natural por acción de los mecanismos de propagación propios de la especie. 194","origen":"Suroeste de Europa y Noroeste de África.","islas":"Naturalizada en La Gomera, Tenerife y Gran Canaria.","autor":"GesPlan S.A.U.","pagina":193,"nombre":"Acanthus mollis","fuente":"Compendio de fichas de la Base de especies introducidas en Canarias (2008-2011), Gobierno de Canarias","url":"https://www.gobiernodecanarias.org/medioambiente/descargas/publicaciones/GOBCAN-2022-Compendio-fichas-especies-introducidas-2008-2011.zip"},"altitud":{"p5":320,"p95":960,"min":290,"max":1190,"n":45,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?taxon_key=5415455&geometry=POLYGON((-18.5 27.4,-13.2 27.4,-13.2 29.5,-18.5 29.5,-18.5 27.4))"},"primerRegistro":{"ano":2005,"tipo":"observación","url":"https://www.gbif.org/occurrence/2563587810","fuente":"GBIF"}}