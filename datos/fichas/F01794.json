":{},"enlaces":[],"nivel":"nativo","actualizado":"2026-11-21","gbifClave":2768176,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/2768176","iucnId":null},"tamano":{"min":0.1,"max":0.4,"tipo":"altura","cita":"Planta bulbosa perenne, glabra, con tallo sin hojas de 10-40 cm de alto","fuente":"Wikipedia (es)","url":"https://es.wikipedia.org/wiki/Dipcadi_serotinum"},"ciclo":{"valor":"Perenne","fuente":"Wikipedia (es)"},"forma":{"valor":"roseta","fuente":"Wikipedia (es)"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Dipcadi serotinum555.jpg","autor":"Nanosanchez","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","pagina":"https://commons.wikimedia.org/wiki/File:Dipcadi_serotinum555.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/191153534/medium.jpeg","autor":"gardatxanae","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/191153534","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/256547504/medium.jpg","autor":"Shiqi Zhou","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/256547504","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/268877/medium.jpg","autor":"Alberto Garcia","lic":"CC BY-NC-SA","licUrl":"https://creativecommons.org/licenses/by-nc-sa/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/268877","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/104261461/medium.jpg","autor":"Bastien Alegot","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/104261461","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/nativas/dipcadi-serotinum","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["suroeste de Europa","sureste de Europa","norte de África","Macaronesia","península arábiga","subcontinente indio"],"introducida":[],"nAreasNativa":20,"nAreasIntroducida":0,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:533990-1","nivel":"taxon","nombre":null},"etimologia":{"texto":"Dipcadi: aunque el creador del género no menciona nada acerca del origen de tal nombre, lo cierto es que  ese vocablo figuraba ya en Dodonaeus (1569), refiriéndose a un 'jacinto' que la mayoría de los italianos de entonces llamaban frecuentemente 'dipcadi', vocablo de posible origen árabe por deformación de tibr qarīh, oro puro, por el color amarillento del perianto.\nserotinum: prestado del latín sērōtǐnus, -a, -um, tardío, probablemente por su floración tardía respecto de otras especies de 'jacintos'.\nDipcadi serotinum fue descrita primero por Carlos Linneo como Hyacinthus serotinus y publicado en Species Plantarum, vol. 2, p. 317[1], 1753 y transferido ulteriormente al género Dipcadi, de nueva creación, por Friedrich Kasimir Medikus y publicado en Historia et Commentationes Academiae Electoralis Scientiarum et Elegantiorum Literarum Theodoro-Palatinae, vol. 6, p. 431[2], 1790.","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Dipcadi_serotinum"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"bulboso geófito","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:533990-1"},{"grupo":"Forma de vida","k":"Clima","v":"subtropical","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:533990-1"},{"grupo":"Genética","k":"Número cromosomático","v":"2n = \"64-68\", 16, 32, 28, 32, 36, 40; n = 14, 4","fuente":"CCDB","url":"https://ccdb.tau.ac.il/search/?genus=Dipcadi"}],"altitud":{"p5":10,"p95":960,"min":0,"max":1560,"n":268,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?taxon_key=2768176&geometry=POLYGON((-18.5 27.4,-13.2 27.4,-13.2 29.5,-18.5 29.5,-18.5 27.4))"}}