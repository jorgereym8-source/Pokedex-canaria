{"codigo":"V00081","nombre":"Motacilla cinerea canariensis","autor":"Hartert, 1901","rango":"especie","nombreCompleto":"Motacilla cinerea canariensis Hartert, 1901","comunes":["Alpispa","lavandera cascadeña"],"reino":"Fauna","grupo":"Aves","subgrupo":null,"medio":"Terrestre","clase":"Aves","validez":"Válido","status":"Actual","presencia":{"P":"s","G":"s","T":"s","C":"s"},"origenCsv":"NS","endemicoCsv":true,"nImagenes":5,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/V00081","centinela":"https://www.biodiversidadcanarias.es/centinela/especie/V00081"},"imagenes":[{"id":"154402825","autor":"","licencia":"","documento":"D01701","portada":false,"descripcion":"","credito":"Trujillo, D., 2015"},{"id":"194379819","autor":"","licencia":"","documento":"D03661","portada":false,"descripcion":"","credito":"Barone Tosco, R., 2020"},{"id":"221937937","autor":"","licencia":"","documento":"P00610","portada":false,"descripcion":"","credito":"Bacallado Aránega, J. J., 2021"},{"id":"221937938","autor":"","licencia":"","documento":"P00610","portada":false,"descripcion":"","credito":"Bacallado Aránega, J. J., 2021"},{"id":"221937939","autor":"","licencia":"","documento":"P00610","portada":false,"descripcion":"","credito":"Bacallado Aránega, J. J., 2021"}],"mapaPk":"315","comunTitulo":"Alpispa, lavandera cascadeña","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":true},"macaronesia":{"género":false,"especie":false,"subespecie":true}},"origen":{"nombre":"Nativo Seguro","codigo":"NS","definicion":"Incluye taxones nativos, tanto endémicos como no endémicos. En ambos casos esta categoría será asignada a aquellos taxones de los que se tiene constancia o se intuye que su presencia en Canarias es natural y no asociada a la actividad humana.","documento":"V00419"},"habitats":[{"categoria":"Medio dulceacuícola","documento":"V00120"},{"categoria":"Medio dulceacuícola","documento":"V00269"},{"categoria":"Hábitats rip