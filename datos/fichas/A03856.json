{"codigo":"A03856","nombre":"Habrocerus capillaricornis","autor":"(Gravenhorst, 1806)","rango":"especie","nombreCompleto":"Habrocerus capillaricornis (Gravenhorst, 1806)","comunes":[],"reino":"Fauna","grupo":"Insectos","subgrupo":"Coleópteros","medio":"Terrestre","clase":"Hexapoda","validez":"Válido","status":"Actual","presencia":{"P":"s","G":"s","T":"s","C":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/A03856"},"imagenes":[],"mapaPk":"5378","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":false,"especie":false,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"D03674"},"habitats":[{"categoria":"Laurisilva termófila","documento":"A00200"},{"categoria":"Medio hipógeo","documento":"A01849"}],"protegida":false,"taxonomia":{"Reino":"Metazoa","Filo":"Arthropoda","Clase":"Hexapoda","Orden":"Coleoptera","Familia":"Staphylinidae","Género":"Habrocerus"},"sinonimos":0,"referencias":26,"proteccion":{},"enlaces":[],"actualizado":"2026-11-22","nivel":"introducido","gbifClave":4440583,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/4440583","iucnId":null},"forma":{"valor":"escarabajo","fuente":"Grupo y familia