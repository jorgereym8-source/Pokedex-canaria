{"codigo":"F01053","nombre":"Scabiosa atropurpurea","autor":"L.","rango":"especie","nombreCompleto":"Scabiosa atropurpurea L.","comunes":["Viudita silvestre","flor de viuda"],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Magnoliopsida","validez":"Válido","status":"Actual","presencia":{"H":"s","P":"s","G":"s","T":"s","C":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":1,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F01053"},"imagenes":[{"id":"112985082","autor":"","licencia":"","documento":"F01213","portada":true,"descripcion":"","credito":"Acebes, J. R., 2002"}],"mapaPk":"10111","comunTitulo":"Viudita silvestre, flor de viuda","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":false,"especie":false,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"F01114"},"habitats":[{"categoria":"Herbazales y matorral ruderal nitrófilo","documento":"F00006"}],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Dipsacales","Familia":"Caprifoliaceae","Género":"Scabiosa"},"sinonimos":14,"referencias":38,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":7301011,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/7301011","iucnId":null},"tamano":{"min":0.2,"max":0.6,"tipo":"altura","cita":"Planta bienal, casi glabra, con tallo ramificado de 20-60 cm de alto","fuente":"Wikipedia (es)","url":"https://es.wikipedia.org/wiki/Scabiosa_atropurpurea"},"ciclo":{"valor":"Bienal","fuente":"Wikipedia (es)"},"forma":{"valor":"arbusto","fuente":"Familia o tamaño"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Plate No. 247.jpg","autor":"S. Edwards, Sansum","lic":"Public domain","licUrl":"","pagina":"https://commons.wikimedia.org/wiki/File:Plate_No._247.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/254330344/medium.jpg","autor":"Connor Margetts","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/254330344","nivel":"sinonimo","taxon":"Sixalix atropurpurea"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/70978513/medium.jpg","autor":"kenttrulsson","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/70978513","nivel":"sinonimo","taxon":"Sixalix atropurpurea"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/463332931/medium.jpg","autor":"Sarah Gregg","lic":"CC BY-NC-SA","licUrl":"https://creativecommons.org/licenses/by-nc-sa/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/463332931","nivel":"sinonimo","taxon":"Sixalix atropurpurea"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/83184/medium.jpg","autor":"115527224325819725585","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/83184","nivel":"sinonimo","taxon":"Sixalix atropurpurea"}],"evc":{"url":"https://endemicascan