cripcion":""},{"id":"263586225","autor":"Leticia Rodríguez Sosa","licencia":"","documento":"P02701","portada":false,"descripcion":""}],"mapaPk":"11786","comunTitulo":"Rejalgadera de Doramas","endemicidad":{"canarias":{"género":false,"especie":true,"subespecie":true},"macaronesia":{"género":false,"especie":true,"subespecie":true}},"origen":{"nombre":"Nativo Seguro","codigo":"NS","definicion":"Incluye taxones nativos, tanto endémicos como no endémicos. En ambos casos esta categoría será asignada a aquellos taxones de los que se tiene constancia o se intuye que su presencia en Canarias es natural y no asociada a la actividad humana.","documento":"F01114"},"habitats":[],"protegida":true,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Solanales","Familia":"Solanaceae","Género":"Solanum","Especie":"Solanum vespertilio Aiton"},"sinonimos":13,"referencias":38,"proteccion":{"Catálogo Español/LESRPE":{"Gran Canaria":{"categoria":"En peligro de extinción","definicion":"Taxones o poblaciones cuya superviviencia es poco probable si los factores causales de su actual situación siguen actuando."}},"Catálogo Canario":{"Gran Canaria":{"categoria":"En peligro de extinción","definicion":"Especies \"en peligro de extinción\", que serán, aparte de aquellas con presencia significativa en Canarias y así calificadas por el Catálogo Español de Especies Amenazadas, las que se incorporen de acuerdo con lo previsto en la presente ley o figuren en su anexo I, constituidas por taxones o poblaciones cuya supervivencia es poco probable si los factores causales de su actual situación siguen actuando."}}},"enlaces":[{"titulo":"Planes de Recuperación y/o Conservación","url":"http://www.gobcan.es/boc/2009/058/009.html"},{"titulo":"Ministerio de Transición Ecológica. Libros Rojos","url":"http://www.magrama.gob.es/es/biodiversidad/temas/inventarios-nacionales/1214_tcm7-149682.pdf"},{"titulo":"GBIF-España. Global Biodiversity Information Facility","url":"http://www.gbif.org/species/2932116"}],"gbifId":"2932116","centinela":{"secciones":{"Distribución mundial":"Endemismo canario.","Distribución en Canarias":"Oeste, Centro Norte y Noreste de Gran Canaria.","Origen":"Nativo Seguro (NS)","Hábitat":"Andenes, taliscas y piederriscos de bosques termófilos (acebuchales y almacigales). (Bañares et al., 2004)","Claves de identificación":"Arbusto de hasta 1,5 m. de altura. Poco ramificada desde la base, con tallos y peciolos muy espinosos. Las hojas son simples, grandes, lanceoladas, alternas, estrechas y con un nervio principal provisto de espinas. El haz de la hoja es de color verde claro y el envés está cubierto de pelillos cortos y suaves que dan un aspecto sedoso. Flor violácea intensa. Fruto en baya de color amarillo verdoso, anaranjado en la madurez. Se distingue de Solanum lidii por la morfología de la planta: es más pequeña, más ramificada y con menos espinas que la anterior. (Herrera, B., 2007)"},"pdf":true},"nivel":"insular","actualizado":"2026-11-21","gbifClave":2932116,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"especie","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/2932116","iucnId":null},"tamano":{"min":null,"max":1.5,"tipo":"altura","cita":"Arbusto de hasta 1,5 m","fuente":"Centinela (claves de identificación)","url":"https://www.biodiversidadcanarias.es/centinela/especie/F02148"},"ciclo":{"valor":"Perenne","fuente":"Centinela"},"forma":{"valor":"arbusto","fuente":"Centinela"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"CBN Solanum vespertilio dorame 2015-07-03 Philweb 2.jpg","autor":"Philweb","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","pagina":"https://commons.wikimedia.org/wiki/File:CBN_Solanum_vespertilio_dorame_2015-07-03_Philweb_2.jpg","nivel":"especie","taxon":"Solanum vespertilio"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/113353188/medium.jpeg","autor":"Felix Riegel","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/113353188","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/111542348/medium.jpg","autor":"Michael 2020","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/111542348","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/108246539/medium.jpeg","autor":"Helder Santiago","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/108246539","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/endemicas/gran-canaria/solanum-vespertilio-subsp-doramae","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["Canarias"],"introducida":[],"nAreasNativa":1,"nAreasIntroducida":0,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:1005590-1","nivel":"taxon","nombre":null},"etimologia":{"texto":"Solanum: nombre genérico que deriva del vocablo Latíno equivalente al Griego στρνχνος (strychnos) para designar el Solanum nigrum (la \"Hierba mora\") —y probablemente otras especies del género, incluida la berenjena​— , ya empleado por Plinio el Viejo en su Historia naturalis (21, 177 y 27, 132) y, antes, por Aulus Cornelius Celsus en De Re Medica (II, 33).​ Podría ser relacionado con el Latín sol. -is, \"el sol\", debido a que la planta sería propia de sitios algo soleados.​\nvespertilio: epíteto La palabra en latín significa \"Murciélago\".","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Solanum_vespertilio"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"arbusto","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:1005590-1"},{"grupo":"Forma de vida","k":"Clima","v":"subtropical","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:1005590-1"}]}