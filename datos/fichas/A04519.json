idae","Género":"Gryllus"},"sinonimos":5,"referencias":54,"proteccion":{},"enlaces":[],"actualizado":"2026-11-22","nivel":"introducido","gbifClave":1713034,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/1713034","iucnId":null},"forma":{"valor":"saltamontes","fuente":"Grupo y familia"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"African.field.cricket.arp.jpg","autor":"Arpingstone","lic":"Public domain","licUrl":"","pagina":"https://commons.wikimedia.org/wiki/File:African.field.cricket.arp.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/30959658/medium.jpg","autor":"Paolo Mazzei","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/30959658","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/9137689/medium.jpg","autor":"Martin Grimm","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/9137689","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/10804405/medium.jpg","autor":"Giacomo Gola","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/10804405","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/87990542/medium.jpeg","autor":"Viral joshi","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/87990542","nivel":"taxon"}],"altitud":{"p5":10,"p95":1080,"min":0,"max":1530,"n":268,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?taxon_key=1713034&geometry=POLYGON((-18.5 27.4,-13