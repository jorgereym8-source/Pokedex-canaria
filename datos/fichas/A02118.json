{"codigo":"A02118","nombre":"Scymnus nubilus","autor":"Mulsant, 1850","rango":"especie","nombreCompleto":"Scymnus nubilus Mulsant, 1850","comunes":[],"reino":"Fauna","grupo":"Insectos","subgrupo":"Coleópteros","medio":"Terrestre","clase":"Hexapoda","validez":"Válido","status":"Actual","presencia":{"H":"s","P":"s","G":"s","T":"s","C":"s","F":"s","L":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/A02118"},"imagenes":[],"mapaPk":"6924","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":false,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"D03674"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Metazoa","Filo":"Arthropoda","Clase":"Hexapoda","Orden":"Coleoptera","Familia":"Coccinellidae","Género":"Scymnus"},"sinonimos":4,"referencias":19,"proteccion":{},"enlaces":[],"actualizado":"2026-11-22","nivel":"introducido","gbifClave":5749486,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/5749486","iucnId":null},"tamano":{"min":0.002,"max":0.002,"tipo":"longitud","cita":"La longitud del cuerpo es de 1,5 a 2,0 mm","fuente":"Wikipedia (es)","url":"https://es.wikipedia.org/wiki/Scymnus_nub