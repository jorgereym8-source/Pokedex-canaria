género":false,"especie":true,"subespecie":null}},"origen":{"nombre":"Nativo Seguro","codigo":"NS","definicion":"Incluye taxones nativos, tanto endémicos como no endémicos. En ambos casos esta categoría será asignada a aquellos taxones de los que se tiene constancia o se intuye que su presencia en Canarias es natural y no asociada a la actividad humana.","documento":"F01114"},"habitats":[],"protegida":true,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Malpighiales","Familia":"Violaceae","Género":"Viola"},"sinonimos":1,"referencias":60,"proteccion":{"Catálogo Canario":{"La Palma":{"categoria":"Vulnerable","definicion":"Especies \"vulnerables\", que serán aquéllas con presencia significativa en Canarias y así calificadas por el Catálogo Español de Especies Amenazadas, así como las que se incorporen de acuerdo con lo previsto en la presente ley o figuren en su anexo II, constituidas por taxones o poblaciones que corren el riesgo de pasar a la categoría anterior, en un futuro inmediato, si los factores adversos que actúan sobre ellos no son corregidos, o bien porque sean sensibles a la alteración de su hábitat, debido a que su hábitat característico esté particularmente amenazado, en grave regresión, fraccionado o muy limitado"}}},"enlaces":[{"titulo":"GBIF-España. Global Biodiversity Information Facility","url":"http://www.gbif.org/species/5663911"}],"gbifId":"5663911","centinela":{"secciones":{"Distribución mundial":"Endemismo canario.","Distribución en Canarias":"Centro de La Palma.","Origen":"Nativo Seguro (NS)","Hábitat":"Se encuentra en las cumbres septentrionales de la isla, entre los 1800 y 2400 m.s.m. (Gómez et al., 1996)","Claves de identificación":"Especie herbácea perenne, muy ramificada. Tallos leñosos hacia la base, reptantes, colgantes. Hojas alernas, lanceoladas, de margen ligeramente dentado, densamente pelosas. Flores tricolores, predominando el malva, con manchas blancas y amarillas. Se diferencia de V. cheiranthifolia por ser de mayor tamaño y tener el espolón más largo y delgado. (D. Bramwell & Z. Bramwell, 1991)"},"pdf":true},"nivel":"insular","actualizado":"2026-11-21","gbifClave":8011743,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/8011743","iucnId":null},"ciclo":{"valor":"Perenne","fuente":"Centinela"},"forma":{"valor":"hierba","fuente":"Centinela"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Viola palmensis.jpg","autor":"Tigerente","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","pagina":"https://commons.wikimedia.org/wiki/File:Viola_palmensis.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/60635695/medium.jpeg","autor":"Ina Siebert","lic":"CC0","licUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.es","pagina":"https://www.inaturalist.org/photos/60635695","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/8569675/medium.jpg","autor":"Jörg Hempel","lic":"CC BY-SA","licUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/8569675","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/60635700/medium.jpeg","autor":"Ina Siebert","lic":"CC0","licUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.es","pagina":"https://www.inaturalist.org/photos/60635700","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/endemicas/la-palma/viola-palmensis","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["Canarias"],"introducida":[],"nAreasNativa":1,"nAreasIntroducida":0,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:868889-1","nivel":"t