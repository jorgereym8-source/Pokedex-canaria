8,"referencias":94,"proteccion":{"Directiva Aves":{"Lanzarote":{"categoria":"Anexo I","definicion":"Las especies mencionadas serán objeto de medidas de conservación especiales en cuanto a su hábitat, con el fin de asegurar su supervivencia y su reproducción en su área de distribución."},"Fuerteventura":{"categoria":"Anexo I","definicion":"Las especies mencionadas serán objeto de medidas de conservación especiales en cuanto a su hábitat, con el fin de asegurar su supervivencia y su reproducción en su área de distribución."}},"Catálogo Español/LESRPE":{"Fuerteventura":{"categoria":"Régimen de protección especial","definicion":"Especies, subespecies y poblaciones que sean merecedoras de una atención y protección particular en función de su valor científico, ecológico, cultural, por su singularidad, rareza, o grado de amenaza, así como aquellas que figuren como protegidas en los anexos de las Directivas y los convenios internacionales ratificados por España."},"Lanzarote":{"categoria":"Régimen de protección especial","definicion":"Especies, subespecies y poblaciones que sean merecedoras de una atención y protección particular en función de su valor científico, ecológico, cultural, por su singularidad, rareza, o grado de amenaza, así como aquellas que figuren como protegidas en los anexos de las Directivas y los convenios internacionales ratificados por España."}},"Convenio de Bonn":{"Lanzarote":{"categoria":"Apéndice 2","definicion":"Especies migratorias que deben ser objeto de acuerdos."},"Fuerteventura":{"categoria":"Apéndice 2","definicion":"Especies migratorias que deben ser objeto de acuerdos."}},"Convenio de Berna":{"Lanzarote":{"categoria":"Anejo II","definicion":"Especies de fauna estrictamente protegidas"},"Fuerteventura":{"categoria":"Anejo II","definicion":"Especies de fauna estrictamente protegidas"}}},"enlaces":[{"titulo":"Sexenal 2008-2012","url":"http://cdr.eionet.europa.eu/Converters/run_conversion?file=/es/eu/art12/envur2cnq/ESIC_birds_reports-14314-11233.xml&conv=343&source=remote#A133_B"},{"titulo":"Sexenal 2013-2018","url":"https://cdr.eionet.europa.eu/Converters/run_conversion?file=/es/eu/art12/envxbkmwa/ESIC_birds_reports_20191030-124224.xml&conv=612&source=remote#A133_B"},{"titulo":"Ministerio de Transición Ecológica. Libros Rojos","url":"https://ala78natural.files.wordpress.com/2010/05/alcaravan_comun_de_canarias-libro_rojo1.pdf"},{"titulo":"UICN. Unión Internacional para la Conservación de la Naturaleza","url":"https://www.iucnredlist.org/species/45111439/132038252"},{"titulo":"GBIF-España. Global Biodiversity Information Facility","url":"https://www.gbif.org/species/6066044"}],"uicnId":"45111439","gbifId":"6066044","centinela":{"secciones":{"Distribución mundial":"Endemismo canario.","Distribución en Canarias":"Fuerteventura (incluyendo Lobos), Lanzarote, y archipiélago Chinijo (Graciosa, Montaña Clara, Alegranza y Roque del Este).","Origen":"Nativo Seguro (NS)","Hábitat":"Habita ambientes abiertos en los que dominan formaciones de tabaibal-cardonal, especialmente llanos pedregosos, jables de arena, bordes de malpaíses, cultivos, y terrenos improductivos y roturados. El nido es una suave depresión en el suelo y suele estar situado junto a algún matorral o piedra (Matín, A. & J. A. Lorenzo, 2001).","Claves de identificación":"Se trata de un ave corredora de unos 41 cm. de color terroso listado de oscuro. Posee una cabeza voluminosa con ojos grandes y amarillos y un pico igualmente de color amarillo en la base y oscuro en el extremo. Las patas son largas y amarillentas. En vuelo son muy evidentes unas franjas alares blancas y otra negra. No posee dimorfismo sexual y la subespecie B.o. distinctus es algo más oscura que la B.o. insularum. (González, M. et al, 2002)"},"pdf":true},"nivel":"nativo","actualizado":"2026-11-21","gbifClave":6066044,"uicn":{"codigo":"LC","categoria":"Preocupación menor","nivel":"especie","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/6066044","iucnId":"45111439"},"tamano":{"min":null,"max":0.41,"tipo":"longitud","cita":"Se trata de un ave corredora de unos 41 cm","fuente":"Centinela (claves de identificación)","url":"https://www.biodiversidadcanarias.es/centinela/especie/V00032"},"peso":{"kg":0.459,"tipo":"adulto","fuente":"AnAge","url":"https://genomics.senescence.info/species/entry.php?species=Burhinus_oedicnemus"},"longevidad":{"anos":17.9,"tipo":"máxima registrada","origen":"en libertad","fuente":"AnAge","url":"https://genomics.senescence.info/species/entry.php?species=Burhinus_oedicnemus"},"forma":{"valor":"ave","fuente":"Grupo y familia"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Burhinus oedicnemus insularum Lanzarote 1.jpg","autor":"Frank Vassen from Brussels, Belgium","lic":"CC BY 2.0","licUrl":"https://creativecommons.org/licenses/by/2.0","pagina":"https://commons.wikimedia.org/wiki/File:Burhinus_oedicnemus_insularum_Lanzarote_1.jpg","nivel":"especie","taxon":"Burhinus oedicnemus"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/100928253/medium.jpeg","autor":"Susana Lois","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/100928253","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/344484877/medium.jpg","autor":"Carlo","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/344484877","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/171483890/medium.jpeg","autor":"Marcelo Cabrera","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/171483890","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/476061667/medium.jpeg","autor":"verstraeten","lic":"CC BY-NC","licUrl":"https