{"codigo":"F00110","nombre":"Adonis microcarpa","autor":"DC.","rango":"especie","nombreCompleto":"Adonis microcarpa DC.","comunes":["Ojo de perdiz","pajizo","pajo de gato"],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Magnoliopsida","validez":"Válido","status":"Actual","presencia":{"P":"s","T":"s","C":"s","F":"s","L":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":2,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F00110"},"imagenes":[{"id":"124224225","autor":"","licencia":"","documento":"D02671","portada":false,"descripcion":"","credito":"García-Casanova, G., 2018"},{"id":"124224226","autor":"","licencia":"","documento":"D02671","portada":false,"descripcion":"","credito":"García-Casanova, G., 2018"}],"mapaPk":"11149","comunTitulo":"Ojo de perdiz, pajizo, pajo de gato","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":null,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"F01114"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Ranunculales","Familia":"Ranunculaceae","Género":"Adonis"},"sinonimos":16,"referencias":42,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":5616463,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/5616463","iucnId":null},"tamano":{"min":null,"max":0.15,"tipo":"altura","cita":"La planta tiene por lo general unos 15 cm de altura (puede llegar hasta 40-50 cm), con flores terminales, solitarias","fuente":"Wikipedia (es)","url":"https://es.wikipedia.org/wiki/Adonis_microcarpa"},"ciclo":{"valor":"Anual","fuente":"Wikipedia (es)"},"forma":{"valor":"hierba","fuente":"Wikipedia (es)"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Adonis-microcarpa001.jpg","autor":"M ath K night and Zachi Evenor","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","pagina":"https://commons.wikimedia.org/wiki/File:Adonis-microcarpa001.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/119231291/medium.jpeg","autor":"faluke","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/119231291","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/175257126/medium.jpeg","autor":"Thanasis Papanikolaou","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/175257126","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/333619365/medium.jpg","autor":"Pedro Antonio Lázaro Molinero","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/333619365","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/introducidas/adonis-microcarpa","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["suroeste de Europa","sureste de Europa","este de Europa","norte de África","Macaronesia","oeste de Asia"],"introducida":["centro de Europa","Australia"],"nAreasNativa":25,"nAreasIntroducida":8,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:708126-1","nivel":"taxon","nombre":null},"etimologia":{"texto":"Adonis: nombre genérico que según el Stearn's Dictionary of Plant Names dice: \"La flor se supone que se ha originado a partir de la sangre de Adonis que fue corneado a muerte por un jabalí. Era amado por Afrodita y, según algunas versiones fue cortejado sin éxito. Adonis era considerado por los griegos como el dios de las plantas. Se creía que desaparecía  en el otoño y el invierno para volver a aparecer en la primavera y el verano. Para celebrar su regreso, los griegos adoptaron la costumbre semítica de hacer jardines de Adonis, que consistían en ollas de barro de semillas de rápido crecimiento\".​\nmicrocarpa: epíteto latino que significa \"con pequeños frutos\".​","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Adonis_microcarpa"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"anual","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:708126-1"},{"grupo":"Forma de vida","k":"Clima","v":"templado","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:708126-1"}],"altitud":{"p5":60,"p95":870,"min":60,"max":1700,"n":16,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?taxon_key=5616463&geometry=POLYGON((-18.5 27.4,-13.2 27.4,-13.2 29.5,-18.5 29.5,-18.5 27.4))"},"primerRegistro":{"ano":1852,"tipo":"pliego o ejemplar de colección","url":"https://www.gbif.org/occurrence/2436980225","fuente":"GBIF"}}