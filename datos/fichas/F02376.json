{"codigo":"F02376","nombre":"Bromus sterilis","autor":"L.","rango":"especie","nombreCompleto":"Bromus sterilis L.","comunes":[],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Liliopsida","validez":"Válido","status":"Actual","presencia":{"P":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F02376"},"imagenes":[],"mapaPk":"15356","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":false,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"F01568"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Liliopsida","Orden":"Poales","Familia":"Poaceae","Género":"Bromus"},"sinonimos":2,"referencias":4,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":2703647,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/2703647","iucnId":null},"tamano":{"min":null,"max":0.4,"tipo":"altura","cita":"Planta herbácea, de unos 40 cm de altura, suave en la parte inferior, algo rugosa en la parte superior","fuente":"Wikipedia (es)","url":"https://es.wikip