{"codigo":"A05539","nombre":"Scutigera coleoptrata","autor":"(Linnaeus, 1758)","rango":"especie","nombreCompleto":"Scutigera coleoptrata (Linnaeus, 1758)","comunes":["Madre ciempiés"],"reino":"Fauna","grupo":"Miriápodos","subgrupo":null,"medio":"Terrestre","clase":"Chilopoda","validez":"Válido","status":"Actual","presencia":{"H":"s","P":"s","G":"s","T":"s","C":"s","F":"s","L":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":3,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/A05539"},"imagenes":[{"id":"112984163","autor":"","licencia":"","documento":"D02433","portada":true,"descripcion":"","credito":"Camacho, A., 2017"},{"id":"196378631","autor":"","licencia":"","documento":"D03703","portada":false,"descripcion":"","credito":"Camacho, A., 2020"},{"id":"246645482","autor":"","licencia":"","documento":"P01507","portada":false,"descripcion":"","credito":"Ojeda-Land, E., 2022"}],"mapaPk":"3213","comunTitulo":"Madre ciempiés","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":null,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"A02090"},"habitats":[{"categoria":"Medio hipógeo","documento":"A02067"},{"categoria":"Medio hipógeo","documento":"A01849"}],"protegida":false,"taxonomia":{"Reino":"Metazoa","Filo":"Arthropoda","Clase":"Chilopoda","Orden":"Scutigeromorpha","Familia":"Scutigeridae","Género":"Scutigera"},"sinonimos":1,"referencias":36,"proteccion":{},"enlaces":[],"actualizado":"2026-11-22","nivel":"introducido","gbifClave":5179027,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/5179027","iucnId":null},"tamano":{"min":null,"max":0.01,"tipo":"longitud","cita":"Coleoptrata mide entre 10 milímetros (0,39 plg) a 50 milímetros (1,97 plg) de largo y puede tener hasta quince pares de patas","fuente":"Wikipedia (es)","url":"https://es.wikipedia.org/wiki/Scutigera_coleoptrata"},"forma":{"valor":"ciempies","fuente":"Grupo y familia"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Scutigera coleoptrata MHNT.jpg","autor":"Didier Descouens","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","pagina":"https://commons.wikimedia.org/wiki/File:Scutigera_coleoptrata_MHNT.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/98501891/medium.jpg","autor":"Марина Горбунова-Ëлкина","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/98501891","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/29579807/medium.jpg","autor":"Kyle Elshoff","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/29579807","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/33400570/medium.jpg","autor":"Tony Iwane","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/33400570","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/56797758/medium.jpeg","autor":"Cecile Roux","lic":"CC BY-SA","licUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/56797758","nivel":"taxon"}],"etimologia":{"texto":"Carlos Linneo había descrito la especie en la décima edición de su Systema Naturae (1758) con el nombre Scolopendra coleoptrata, diciendo que tenía \"tórax coleopterado\" (con forma de coleóptero). En 1801, Jean-Baptiste Lamarck separó los escutígeros de las escolopendras, llamando a esta especie Scutigera coleoptrata. La palabra escutígero viene de \"portar\" (gerere) y \"escudo\" (scutum), debido a la forma de los segmentos torácicos del quilópodo.","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Scutigera_coleoptrata"},"altitud":{"p5":10,"p95":930,"min":0,"max":2320,"n":108,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?taxon_key=5179027&geometry=POLYGON((-18.5 27.4,-13.2 27.4,-13.2 29.5,-18.5 29.5,-18.5 27.4))"},"primerRegistro":{"ano":1970,"tipo":"observación","url":"https://www.gbif.org/occurrence/4956329296","fuente":"GBIF"}}