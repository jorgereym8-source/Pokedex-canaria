nifica \"común\".","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Silene_vulgaris"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"perenne","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:77250265-1"},{"grupo":"Forma de vida","k":"Clima","v":"templado","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:77250265-1"},{"grupo":"Genética","k":"Número cromosomático","v":"2n = 12, 12, 24, 24, 24+0-1B, 24, 48, 24,48; n = 12, 24, n = 12","fuente":"CCDB","url":"https://ccdb.tau.ac.il/search/?genus=Silene"}]}