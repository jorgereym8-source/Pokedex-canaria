{"codigo":"F02037","nombre":"Sporobolus diandrus","autor":"(Retz.) P. Beauv.","rango":"especie","nombreCompleto":"Sporobolus diandrus (Retz.) P. Beauv.","comunes":["Espartillo bastardo"],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Liliopsida","validez":"Válido","status":"Actual","presencia":{"T":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F02037"},"imagenes":[],"mapaPk":"11604","comunTitulo":"Espartillo bastardo","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":false,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"F01114"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Liliopsida","Orden":"Poales","Familia":"Poaceae","Género":"Sporobolus"},"sinonimos":0,"referencias":6,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":4150685,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/4150685","iucnId":null},"forma":{"valor":"planta","fuente":"Familia o tamaño"},"fotosLibres":[{"fuente":"iNaturalist","url":"https://