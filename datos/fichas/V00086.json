{"codigo":"V00086","nombre":"Fringilla teydea","autor":"Webb, Berthelot & Moquin-Tandon, 1842","rango":"especie","nombreCompleto":"Fringilla teydea Webb, Berthelot & Moquin-Tandon, 1842","comunes":["Pinzón azul","pinzón azul de Tenerife"],"reino":"Fauna","grupo":"Aves","subgrupo":null,"medio":"Terrestre","clase":"Aves","validez":"Válido","status":"Actual","presencia":{"T":"s"},"origenCsv":"NS","endemicoCsv":true,"nImagenes":5,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/V00086","centinela":"https://www.biodiversidadcanarias.es/centinela/especie/V00086"},"imagenes":[{"id":"108855914","autor":"","licencia":"","documento":"D02147","portada":true,"descripcion":"","credito":"Vermeersch, C., 2016"},{"id":"104038762","autor":"","licencia":"","documento":"D01701","portada":false,"descripcion":"","credito":"Trujillo, D., 2015"},{"id":"206635026","autor":"","licencia":"","documento":"D03661","portada":false,"descripcion":"","credito":"Barone Tosco, R., 2020"},{"id":"206635027","autor":"","licencia":"","documento":"D03661","portada":false,"descripcion":"","credito":"Barone Tosco, R., 2020"},{"id":"237535244","autor":"","licencia":"","documento":"P01159","portada":false,"descripcion":"","credito":"Barone Tosco, R., 2022"}],"mapaPk":"320","comunTitulo":"Pinzón azul, pinzón azul de Tenerife","endemicidad":{"canarias":{"género":false,"especie":true,"subespecie":null},"macaronesia":{"género":false,"especie":true,"subespecie":null}},"origen":{"nombre":"Nativo Seguro","codigo":"NS","definicion":"Incluye taxones nativos, tanto endémicos como no endémicos. En ambos casos esta categoría será asignada a aquellos taxones de los que se tiene constancia o se intuye que su presencia en Canarias es natural y no asociada a la actividad humana.","documento":"V00419"},"habitats":[{"categoria":"Pinar húmedo","documento":"V00120"},{"categoria":"Pinar","documento":"V00120"},{"categoria":"Pinar","documento":"V00269"}],"protegida":true,"taxonomia":{"Reino":"Metazoa","Filo":"Chordata","Clase":"Aves","Orden":"Passeriformes","Familia":"Fringillidae","Género":"Fringilla"},"sinonimos":57,"referencias":65,"proteccion":{"Directiva Aves":{"Tenerife":{"categoria":"Anexo I","definicion":"Las especies mencionadas serán objeto de medidas de conservación especiales en cuanto a su hábitat, con el fin de asegurar su supervivencia y su reproducción en su área de distribución."}},"Catálogo Español/LESRPE":{"Tenerife":{"categoria":"Vulnerable","definicion":"Taxones o poblaciones que corren el riesgo de pasar a la categoría anterior en un futuro inmediato si los factores adversos que actúan sobre ellos no son corregidos."}},"Catálogo Canario":{"Tenerife":{"categoria":"Vulnerable","definicion":"Especies \"vulnerables\", que serán aquéllas con presencia significativa en Canarias y así calificadas por el Catálogo Español de Especies Amenazadas, así como las que se incorporen de acuerdo con lo previsto en la presente ley o figuren en su anexo II, constituidas por taxones o poblaciones que corren el riesgo de pasar a la categoría anterior, en un futuro inmediato, si los factores adversos que actúan sobre ellos no son corregidos, o bien porque sean sensibles a la alteración de su hábitat, debido a que su hábitat característico esté particularmente amenazado, en grave regresión, fraccionado o muy limitado"}},"Convenio de Berna":{"Tenerife":{"categoria":"Anejo II","definicion":"Especies de fauna estrictamente protegidas"}}},"enlaces":[{"titulo":"Sexenal 2008-2012","url":"http://cdr.eionet.europa.eu/Converters/run_conversion?file=/es/eu/art12/envur2cnq/ESIC_birds_reports-14314-11233.xml&conv=343&source=remote#A636_B"},{"titulo":"Sexenal 2013-2018","url":"https://cdr.eionet.europa.eu/Converters/run_conversion?file=/es/eu/art12/envxbkmwa/ESIC_birds_reports_20191030-124224.xml&conv=612&source=remote#A486_B"},{"titulo":"Ministerio de Transición Ecológica. Libros Rojos","url":"http://www.mapama.gob.es/es/biodiversidad/temas/inventarios-nacionales/pinzon_azul_tcm7-21847.pdf"},{"titulo":"UICN. Unión Internacional para la Conservación de la Naturaleza","url":"https://www.iucnredlist.org/species/103822567/111091603"},{"titulo":"GBIF-España. Global Biodiversity Information Facility","url":"http://www.gbif.org/species/7060537"}],"uicnId":"103822567","gbifId":"7060537","centinela":{"secciones":{"Distribución mundial":"Endemismo canario.","Distribución en Canarias":"Centro y Norte de Tenerife.","Origen":"Nativo Seguro (NS)","Hábitat":"Restringido a los bosques de pinos de las islas centrales, con predilección por pinares con sotobosque de escobones. Su presencia en el matorral de alta montaña es ocasional. El nido se ubica en pinos aunque también en laurel y brezo, excepcionalmente puede utilizar nidos de otras especies, como el del canario. Realiza movimientos altitudinales hacia las zonas de alta montaña y hacia el borde inferior del pinar, llegando incluso hasta áreas de cultivos situados alrededor de los 700 m. Se conocen desplazamientos dispersivos de juveniles hasta de 3 km. (Matín, A. & J. A. Lorenzo, 2001)","Claves de identificación":"Pinzón de 16,5 cm de longitud. El macho es de color azul oscuro, a excepción del vientre y las infracobertoras caudales que son blancuzcas. Las alas y la cola son muy oscuras, casi negras. La franja frontal negra sobre el pico sólo es patente en los machos más viejos. Las franjas alares son azuladas. Las hembras y los jóvenes son pardo-oliváceo. F. t. polatzeki se diferencia de F.t. teydea fundamentalmente por su menor tamaño y por la presencia de una banda oscura en la frente, justo por encima de la parte superior del pico.(Viceconsejería de Medio Ambiente, 2001, http://www.seo.org/ave/pinzon-azul/)"},"pdf":true},"nivel":"insular","actualizado":"2026-11-21","gbifClave":2494442,"uicn":{"codigo":"NT","categoria":"Casi amenazada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/2494442","iucnId":"103822567"},"tamano":{"min":null,"max":0.165,"tipo":"longitud","cita":"Pinzón de 16,5 cm de longitud","fuente":"Centinela (claves de identificación)","url":"https://www.biodiversidadcanarias.es/centinela/especie/V00086"},"forma":{"valor":"ave","fuente":"Grupo y familia"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Teidefink.jpg","autor":"Bartkauz at German Wikipedia","lic":"Public domain","licUrl":"","pagina":"https://commons.wikimedia.org/wiki/File:Teidefink.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/185026890/medium.jpeg","autor":"Christoph Moning","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/185026890","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/13403074/medium.jpg","autor":"Scott Bowers","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/13403074","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/13403076/medium.jpg","autor":"Scott Bowers","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/13403076","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/185026696/medium.jpeg","autor":"Christoph Moning","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/185026696","nivel":"taxon"}],"rasgos":[{"grupo":"Morfología","k":"Longitud del ala","v":"9,7 cm","fuente":"AVONET","url":"https://doi.org/10.1111/ele.13898"},{"grupo":"Morfología","k":"Longitud de la cola","v":"7,9 cm","fuente":"AVONET","url":"https://doi.org/10.1111/ele.13898"},{"grupo":"Morfología","k":"Longitud del pico","v":"20,4 mm","fuente":"AVONET","url":"https://doi.org/10.1111/ele.1389