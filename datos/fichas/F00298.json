{"codigo":"F00298","nombre":"Rumex pulcher subsp. woodsii","autor":"(De Not.) Arcang.","rango":"subespecie","nombreCompleto":"Rumex pulcher L. subsp. woodsii (De Not.) Arcang.","comunes":["Labasa timplera","vinagrera hermosa"],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Magnoliopsida","validez":"Válido","status":"Actual","presencia":{"H":"s","P":"s","G":"s","T":"s","C":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F00298"},"imagenes":[],"mapaPk":"10492","comunTitulo":"Labasa timplera, vinagrera hermosa","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":false},"macaronesia":{"género":false,"especie":false,"subespecie":false}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"F01114"},"habitats":[{"categoria":"Herbazales y matorral ruderal nitrófilo","documento":"F00006"}],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Caryophyllales","Familia":"Polygonaceae","Género":"Rumex","Especie":"Rumex pulcher L."},"sinonimos":22,"referencias":40,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":7415922,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"especie","fuente":"Lista