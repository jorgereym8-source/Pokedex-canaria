{"codigo":"F01758","nombre":"Allium cepa","autor":"L.","rango":"especie","nombreCompleto":"Allium cepa L.","comunes":["Cebolla"],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Liliopsida","validez":"Válido","status":"Actual","presencia":{"G":"s","T":"s","C":"s","F":"s","L":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":2,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F01758"},"imagenes":[{"id":"112985029","autor":"","licencia":"","documento":"F01213","portada":true,"descripcion":"","credito":"Acebes, J. R., 2002"},{"id":"124224409","autor":"","licencia":"","documento":"D02671","portada":false,"descripcion":"","credito":"García-Casanova, G., 2018"}],"mapaPk":"11199","comunTitulo":"Cebolla","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":false,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"F01114"},"habitats":[{"categoria":"Zonas de cultivo","documento":"F00092"}],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Liliopsida","Orden":"Asparagales","Familia":"Amaryllidaceae","Género":"Allium"},"sinonimos":0,"referencias":21,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":2857697,"uic