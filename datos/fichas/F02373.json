{"codigo":"F02373","nombre":"Agrostis stolonifera subsp. stolonifera","autor":"L.","rango":"subespecie","nombreCompleto":"Agrostis stolonifera L. subsp. stolonifera","comunes":[],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Liliopsida","validez":"Válido","status":"Actual","presencia":{"P":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F02373"},"imagenes":[],"mapaPk":"15126","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":false},"macaronesia":{"género":false,"especie":false,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"F01568"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Liliopsida","Orden":"Poales","Familia":"Poaceae","Género":"Agrostis","Especie":"Agrostis stolonifera L."},"sinonimos":0,"referencias":4,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":2706435,"uicn":{"codigo":"LC","categoria":"Preocupación menor","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/2706435","iucnId":"164020"},"tamano":{"min":0.35,"max":0.8,"tipo":"altura","cita":"Tallos de 35-80 cm, generalmente decumbentes o asce