{"codigo":"E07806","nombre":"Rumex pulcher subsp. pulcher","autor":"L.","rango":"subespecie","nombreCompleto":"Rumex pulcher L. subsp. pulcher","comunes":[],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Magnoliopsida","validez":"Válido","status":"Actual","presencia":{"P":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/E07806"},"imagenes":[],"mapaPk":"108560641","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":false},"macaronesia":{"género":false,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"D03441"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Caryophyllales","Familia":"Polygonaceae","Género":"Rumex","Especie":"Rumex pulcher L."},"sinonimos":0,"referencias":4,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":4036957,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/4036957","iucnId":null},"ciclo":{"valor":"Perenne","fuente":"Wikipedia (es)"},"forma":{"valor":"hierba","fuente":"Wikipedia (es)"},"fotosLibres":[{"fue