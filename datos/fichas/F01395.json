cencia":"","documento":"P03256","portada":false,"descripcion":""}],"mapaPk":"10708","comunTitulo":"Tomillo de Taganana, tomillo de risco","endemicidad":{"canarias":{"género":false,"especie":true,"subespecie":null},"macaronesia":{"género":false,"especie":true,"subespecie":null}},"origen":{"nombre":"Nativo Seguro","codigo":"NS","definicion":"Incluye taxones nativos, tanto endémicos como no endémicos. En ambos casos esta categoría será asignada a aquellos taxones de los que se tiene constancia o se intuye que su presencia en Canarias es natural y no asociada a la actividad humana.","documento":"F01114"},"habitats":[{"categoria":"Escarpes rocosos","documento":"F00039"}],"protegida":true,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Lamiales","Familia":"Lamiaceae","Género":"Micromeria"},"sinonimos":3,"referencias":42,"proteccion":{"Catálogo Español/LESRPE":{"Tenerife":{"categoria":"En peligro de extinción","definicion":"Taxones o poblaciones cuya superviviencia es poco probable si los factores causales de su actual situación siguen actuando."}},"Catálogo Canario":{"Tenerife":{"categoria":"En peligro de extinción","definicion":"Especies \"en peligro de extinción\", que serán, aparte de aquellas con presencia significativa en Canarias y así calificadas por el Catálogo Español de Especies Amenazadas, las que se incorporen de acuerdo con lo previsto en la presente ley o figuren en su anexo I, constituidas por taxones o poblaciones cuya supervivencia es poco probable si los factores causales de su actual situación siguen actuando."}},"Convenio de Berna":{"Tenerife":{"categoria":"Anejo I","definicion":"Especies de flora estrictamente protegida"}}},"enlaces":[{"titulo":"Ministerio de Transición Ecológica. Libros Rojos","url":"http://www.magrama.gob.es/es/biodiversidad/temas/inventarios-nacionales/716_tcm7-149487.pdf"},{"titulo":"UICN. Unión Internacional para la Conservación de la Naturaleza","url":"http://www.iucnredlist.org/details/195484/0"},{"titulo":"GBIF-España. Global Biodiversity Information Facility","url":"https://www.gbif.org/species/5606476"}],"uicnId":"195484","gbifId":"5606476","centinela":{"secciones":{"Distribución mundial":"Endemismo canario.","Distribución en Canarias":"Noreste de Tenerife.","Origen":"Nativo Seguro (NS)","Hábitat":"Propia de ambientes rocosos, viviendo en las fisuras presentes en Roques y otros lugares escarpados y soleados del área de los bosques termófilos (Gómez et al., 1996)","Claves de identificación":"Pequeño arbusto de 10-40 cm. de alto, leñoso. Hojas ovaladas, ligeramente pelosas en el envés, a menudo matizadas de rojo en los lugares más soleados. Inflorescencias densas en el ápice de las ramas, formando una corona. Cáliz peloso en el exterior, matizado de rojizo, bilabiado. Corola púrpura, pelosa en la parte superior externa del tubo y exterior del limbo. Se diferencia de Micromeria rivas-martinezii Wilpret por el menor porte, la disposición de las hojas más laxas y los dientes del cáliz no ensanchados en la base. Del resto de las especies de Tenerife se diferencia por sus grandes flores. (Bañares, A. et al., 2004, Mesa, R., 2014)"},"pdf":true},"nivel":"insular","actualizado":"2026-11-21","gbifClave":5606476,"uicn":{"codigo":"CR","categoria":"En peligro crítico","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/5606476","iucnId":"195484"},"tamano":{"min":0.1,"max":0.4,"tipo":"altura","cita":"Pequeño arbusto de 10-40 cm","fuente":"Centinela (claves de identificación)","url":"https://www.biodiversidadcanarias.es/centinela/especie/F01395"},"ciclo":{"valor":"Perenne","fuente":"Centinela"},"forma":{"valor":"arbusto","fuente":"Centinela"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Micromeria Glomerata at CBNB (17).jpg","autor":"G.Mannaerts","lic":"CC BY-SA 4.0","licUrl":"https://creativecommons.org/licenses/by-sa/4.0","pagina":"https://commons.wikimedia