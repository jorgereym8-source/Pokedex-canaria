{"codigo":"V00245","nombre":"Cyanistes teneriffae hedwigae","autor":"(Dietzen, García del Rey, Delgado Castro & Wink, 2008)","rango":"especie","nombreCompleto":"Cyanistes teneriffae hedwigae (Dietzen, García del Rey, Delgado Castro & Wink, 2008)","comunes":["Herrerillo común"],"reino":"Fauna","grupo":"Aves","subgrupo":null,"medio":"Terrestre","clase":"Aves","validez":"Válido","status":"Actual","presencia":{"C":"s"},"origenCsv":"NS","endemicoCsv":true,"nImagenes":1,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/V00245","centinela":"https://www.biodiversidadcanarias.es/centinela/especie/V00245"},"imagenes":[{"id":"263586823","autor":"M. Arechavaleta","licencia":"","documento":"P02752","portada":false,"descripcion":"","credito":"M. Arechavaleta"}],"mapaPk":"480","comunTitulo":"Herrerillo común","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":true},"macaronesia":{"género":null,"especie":false,"subespecie":true}},"origen":{"nombre":"Nativo Seguro","codigo":"NS","definicion":"Incluye taxones nativos, tanto endémicos como no endémicos. En ambos casos esta categoría será asignada a aquellos taxones de los que se tiene constancia o se intuye que su presencia en Canarias es natural y no asociada a la actividad humana.","documento":"V00543"},"habitats":[],"protegida":true,"taxonomia":{"Reino":"Metazoa","Filo":"Chordata","Clase":"Aves","Orden":"Passeriformes","Familia":"Paridae","Género":"Cyanistes","Especie":"Cyanistes teneriffae (Lesson, 1831)"},"sinonimos":43,"referencias":45,"proteccion":{"Catálogo Español/LESRPE":{"Gran Canaria":{"categoria":"Régimen de protección especial","definicion":"Especies, subespecies y poblaciones que sean merecedoras de una atención y protección particular en función de su valor científico, ecológico, cultural, por su singularidad, rareza, o grado de amenaza, así como aquellas que figuren como protegidas en los anexos de las Directivas y los convenios internacionales ratificados por España."}},"Convenio de Berna":{"Gran Canaria":{"categoria":"Anejo II","definicion":"Especies de fauna estrictamente protegidas"}}},"enlaces":[{"titulo":"Sexenal 2008-2012","url":"http://cdr.eionet.europa.eu/Converters/run_conversion?file=/es/eu/art12/envur2cnq/ESIC_birds_reports-14314-11233.xml&conv=343&source=remote#A329_B"},{"titulo":"Sexenal 2013-2018","url":"https://cdr.eionet.europa.eu/Converters/run_conversion?file=/es/eu/art12/envxbkmwa/ESIC_birds_reports_20191030-124224.xml&conv=612&source=remote#A484_B"},{"titulo":"UICN. Unión Internacional para la Conservación de la Naturaleza","url":"https://www.iucnredlist.org/species/103761672/104117708"},{"titulo":"GBIF-España. Global Biodiversity Information Facility","url":"https://www.gbif.org/species/8022607"}],"uicnId":"103761672","gbifId":"8022607","centinela":{"secciones":{"Distribución mundial":"Endemismo canario.","Distribución en Canarias":"Prácticamente toda la isla de Gran Canaria.","Origen":"Nativo Seguro (NS)","Hábitat":"Presente en bosques, tanto pinares como monteverde. Además, se le puede observar en zonas de cultivos, sobre todo en los inmediatos al límite inferior del bosque. También penetra en las partes más húmedas del piso basal a través de barrancos, y en menor medida en pueblos y ciudades (Matín, A. & J. A. Lorenzo, 2001)","Claves de identificación":"Pájaro pequeño, de 11 cm de longitud y 20 de envergadura. Pico fino y corto. Dorso algo más pálido y más gris que las de Tenerife. Mancha negra de la garganta más ancha con bordes laterales más convexos. (salvador, A., 2016)","Cambios taxonómicos relevantes":"Recientemente ha sido incluido en el género Cyanistes (Gill et al., 2005). En el Catálogo de Especies Amenazadas de Canarias vigente y en BIOTA figura como Parus teneriffae."},"pdf":true},"nivel":"nativo","actualizado":"2026-11-21","gbifClave":8022607,"uicn":{"codigo":"LC","categoria":"Preocupación menor","nivel":"especie","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/8022607","iucnId":"103761672"},"tamano":{"min":null,"max":0.11,"tipo":"longitud","cita":"Pájaro pequeño, de 11 cm de longitud y 20 de envergadura","fuente":"Centinela (claves de identificación)","url":"https://www.biodiversidadcanarias.es/centinela/especie/V00245"},"forma":{"valor":"ave","fuente":"Grupo y familia"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Herrerillo común (Parus caeruleus teneriffae).jpg","autor":"Juan Emilio","lic":"CC BY-SA 2.0","licUrl":"https://creativecommons.org/licenses/by-sa/2.0","pagina":"https://commons.wikimedia.org/wiki/File:Herrerillo_com%C3%BAn_(Parus_caeruleus_teneriffae).jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/161925732/medium.jpg","autor":"Thibaud Aronson","lic":"CC BY-SA","licUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/161925732","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/117120055/medium.jpg","autor":"Felix Riegel","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/117120055","nivel":"taxon"}],"rasgos":[{"grupo":"Morfología","k":"Longitud del ala","v":"6 cm","fuente":"AVONET","url":"https://doi.org/10.1111/ele.13898"},{"grupo":"Morfología","k":"Longitud de la cola","v":"4,9 cm","fuente":"AVONET","url":"https://doi.org/10.1111/ele.13898"},{"grupo":"Morfología","k":"Longitud del pico","v":"10,4 mm","fuente":"AVONET","url":"https://doi.org/10.1111/ele.13898"},{"grupo":"Morfología","k":"Peso medio","v":"10 g","fuente":"AVONET","url":"https://doi.org/10.1111/ele.13898"},{"grupo":"Morfología","k":"Índice mano-ala","v":"14,2 (más alto = alas más largas y apuntadas)","fuente":"AVONET","url":"https://doi.org/10.1111/ele.13898"},{"grupo":"Alimentación","k":"Nicho trófico","v":"omnívoro","fuente":"AVONET","url":"https://d