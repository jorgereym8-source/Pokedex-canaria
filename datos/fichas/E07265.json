odigo":"ISP","definicion":"Incluye aquellos taxones que se introducen o establecen en un hábitat natural o seminatural y que podrían convertirse en invasores en Canarias, en especial aquellos que han demostrado ese carácter en otros países o regiones de características ecológicas semejantes a las de Canarias.","documento":"D03441"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Caryophyllales","Familia":"Cactaceae","Género":"Oreocereus"},"sinonimos":3,"referencias":9,"proteccion":{"CITES":{"Tenerife":{"categoria":"Apéndice II","definicion":"Especies que, si bien no se encuentran en peligro de extinción, podrían llegar a estarlo a menos que el comercio en especímenes de dichas especies esté sujeto a una reglamentación estricta a fin de evitar utilización incompatible con su supervivencia, y aquellas otras especies no afectadas por el comercio, que también deberán sujetarse a reglamentación con el fin de permitir un eficaz control del comercio en las especies a que se refiere el párrafo anterior."}}},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":3952236,"uicn":{"codigo":"NT","categoria":"Casi amenazada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/3952236","iucnId":"152552"},"tamano":{"min":null,"max":2.0,"tipo":"altura","cita":"Cactus de porte arbustivo, con una ramificación irregular en la mitad inferior de la planta, que puede alcanzar hasta 2 m de altura","fuente":"Wikipedia (es)","url":"https://es.wikipedia.org/wiki/Oreocereus_pseudofossulatus"},"forma":{"valor":"arbusto","fuente":"Wikipedia (es)"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Oreocereus fossulatus rubrispinus 1.jpg","autor":"Stan Shebs","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","pagina":"https://commons.wikimedia.org/wiki/File:Oreocereus_fossulatus_rubrispinus_1.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/241627320/medium.jpg","autor":"Sean Vanderluit","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/241627320","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/346437554/medium.jpeg","autor":"Alejandro Bruno Miranda-Calle","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/346437554","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/introducidas/oreocereus-pseudofossulatus","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["oeste de Sudamérica"],"introducida":["Macaronesia"],"nAreasNativa":1,"nAreasIntroducida":1,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:961702-1","nivel":"taxon","nombre":null},"etimologia":{"texto":"Oreocereus: nombre genérico formado por la combinación del término griego oreos (que significa 'montaña') y cereus (que se traduce como 'vela' o 'cirio'). El nombre hace alusión al hábitat montañoso de estas plantas, que crecen a grandes altitudes en la cordillera de los Andes, por lo que puede interpretarse como «cirio de montaña».\npseudofossulatus: epíteto específico formado por la combinación del prefijo griego pseudo- (que significa 'falso' o 'que parece ser') y el término latino fossulatus (que significa 'provisto de surcos' o «'acanalado'). El nombre se estableció como una nueva denominación para Cleistocactus fossulatus, con el fin de evitar la homonimia con Oreocereus fossulatus (actualmente Oreocereus celsianus), ya que ambos nombres correspondían a especies diferentes.","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Oreocereus_pseudofossulatus"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"suculenta arbusto","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:961702-1"},{"grupo":"Forma de vida","k":"Clima","v":"desierto o matorral seco","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:961702-1"}]}