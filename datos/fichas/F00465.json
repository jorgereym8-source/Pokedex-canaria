":{"género":false,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Seguro No invasor","codigo":"ISN","definicion":"Incluye aquellos taxones cuya introducción (accidental o deliberada) está registrada en la bibliografía y otros considerados cosmopolitas y de amplia distribución fuera del ámbito de Canarias. Se incluyen también los taxones introducidos de los que se ignora su carácter invasivo.","documento":"D03441"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Fabales","Familia":"Fabaceae","Género":"Caesalpinia"},"sinonimos":0,"referencias":19,"proteccion":{},"enlaces":[{"titulo":"Compendio de fichas de la Base de Especies Introducidas en Canarias (2008-2011)","url":"https://www.gobiernodecanarias.org/medioambiente/descargas/publicaciones/GOBCAN-2022-Compendio-fichas-especies-introducidas-2008-2011.zip"}],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":5354727,"uicn":{"codigo":"LC","categoria":"Preocupación menor","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/5354727","iucnId":"226181521"},"tamano":{"min":2.0,"max":5.0,"tipo":"altura","cita":"Spinosa alcanza un tamaño de 2-5 m de altura, su corteza es de color gris oscuro, con espinas dispersas y ramas peludas","fuente":"Wikipedia (es)","url":"https://es.wikipedia.org/wiki/Caesalpinia_spinosa"},"ciclo":{"valor":"Perenne","fuente":"Wikipedia (es)"},"forma":{"valor":"árbol","fuente":"Wikipedia (es)"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Caesalpinia spinosa.jpg","autor":"Autor en Wikimedia Commons","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","pagina":"https://commons.wikimedia.org/wiki/File:Caesalpinia_spinosa.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/93701193/medium.jpg","autor":"navasalfredo","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/93701193","nivel":"sinonimo","taxon":"Tara spinosa"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/171209222/medium.jpeg","autor":"coqwallon","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/171209222","nivel":"sinonimo","taxon":"Tara spinosa"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/introducidas/caesalpinia-spinosa-molina-kuntze","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["Caribe","norte de Sudamérica","oeste de Sudamérica","sur de Sudamérica"],"introducida":["suroeste de Europa","Macaronesia","África tropical nororiental","África tropical oriental","África tropical meridional","sur de África","Malesia","suroeste de EE. UU."],"nAreasNativa":8,"nAreasIntroducida":10,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:249443-2","nivel":"taxon","nombre":"Tara spinosa"},"etimologia":{"texto":"Caesalpinia: nombre genérico que fue otorgado en honor del botánico italianoAndrea Cesalpino (1519-1603).\nspinosa: epíteto latino que significa \"con espinas\".\nOtros nombres:\nCaesalpinia pectinata Cav.\nCaesalpinia tara Ruiz & Pav.\nCaesalpinia tinctoria (Kunth) Benth. ex Reiche\nCoulteria tinctoria Kunth\nPoinciana spinosa Molina\nTara spinosa (Molina) Britton & Rose","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Caesalpinia_spinosa"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"arbusto o árbol","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:249443-2"},{"grupo":"Forma de vida","k":"Clima","v":"tropical estacionalmente seco","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:249443-2"}],"introduccion":{"fecha":"Probablemente una introducción relativamente temprana (siglo XIX o antes), en el transcurso de los estrechos lazos de Canarias con Latinoamérica.","via":"Como ornamental y para repoblaciones en lugares áridos.","dispersion":"A corta distancia las semillas son dispersadas principalmente por vía abiótica (gravedad, agua de escorrentía), no existiendo para Canarias datos sobre posible dispersión zoócora. A media y larga distancia son dispersadas con el transporte de plantas y tierra. Las semillas tienen cubierta dura, pero germinan bien tras lluvias.","origen":"Parte noroccidental de Sudamérica: Venezuela, Colombia, Ecuador, Perú y Bolivia hasta el norte de Chile.","islas":"Tenerife, Gran Canaria y Fuerteventura. 315","autor":"Stephan Scholz","ano":"2008","pagina":315,"nombre":"Caesalpinia spinosa","fuente":"Compendio de fichas de la Base de especies introducidas en Canarias (2008-2011), Gobierno de Canarias","url":"https://www.gobiernodecanarias.org/medioambiente/descargas/publicaciones/GOBCAN-2022-Compendio-fichas-especies-introducidas-2008-2011.zip"},"altitud":{"p5":30,"p95":470,"min":20,"max":1050,"n":21,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?taxon_key=5354727&geometry=POLYGON((-18.5 27.4,-13.2 27.4,-13.2 29.5,-18.5 29.5,-18.5 27.4))"},"primerRegistro":{"ano":2011,"tipo":"observación","url":"https://www.gbif.org/occurrence/4890562010","fuente":"GBIF"}}