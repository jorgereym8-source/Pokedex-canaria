{"codigo":"F01761","nombre":"Allium paniculatum","autor":"L.","rango":"especie","nombreCompleto":"Allium paniculatum L.","comunes":["Ajo abierto"],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Liliopsida","validez":"Válido","status":"Actual","presencia":{"P":"s","T":"s","C":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F01761"},"imagenes":[],"mapaPk":"11202","comunTitulo":"Ajo abierto","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":false,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"D03441"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Liliopsida","Orden":"Asparagales","Familia":"Amaryllidaceae","Género":"Allium"},"sinonimos":3,"referencias":13,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":2856288,"uicn":{"codigo":"VU","categoria":"Vulnerable","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/2856288","iucnId":"13143403_1"},"forma":{"valor":"hierba","fuente":"Wikipedia (es)"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Allium paniculat