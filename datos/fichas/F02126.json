":"Wikimedia Commons","archivo":"Fumaria muralis01.jpg","autor":"Autor en Wikimedia Commons","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","pagina":"https://commons.wikimedia.org/wiki/File:Fumaria_muralis01.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/16104053/medium.jpg","autor":"Tony Rebelo","lic":"CC BY-SA","licUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/16104053","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/63416044/medium.jpg","autor":"Harry Rose","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/63416044","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/13587985/medium.jpeg","autor":"Anne Parsons","lic":"CC0","licUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.es","pagina":"https://www.inaturalist.org/photos/13587985","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/74063406/medium.jpg","autor":"georgetelehin","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/74063406","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/nativas/fumaria-muralis-subsp-muralis","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["norte de Europa","centro de Europa","suroeste de Europa","norte de África","Macaronesia"],"introducida":["norte de Europa","centro de Europa","África tropical centro-occidental","África tropical meridional","sur de África","islas del Atlántico central","oeste del Índico","Australia","Nueva Zelanda","Caribe","islas subantárticas"],"nAreasNativa":12,"nAreasIntroducida":26,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:673038-1","nivel":"taxon","nombre":null},"etimologia":{"texto":"Fumaria: nombre genérico del Latín fumus = \"humo\", posiblemente por el color o el olor de las raíces frescas.\nEl \"humo\" o el origen \"fumy\" de su nombre proviene del color translúcido de sus flores, dándoles la apariencia de humo o de colgar en el humo, y al color bruma ligeramente gris-azulado de su follaje, también se asemeja al humo proveniente del suelo, sobre todo después de rocío de la mañana.\nLa planta ya fue llamado fumus terrae (humo de la tierra) a principios del siglo XIII, y hace dos mil años, Dioscórides escribió en De Materia Medica (Περὶ ὕλης ἰατρικῆς) y Plinio el Viejo en Naturalis Historia que frotarse los ojos con la savia o látex de la planta provoca lágrimas, como el humo acre (fumus) hace a los ojos. Su nombre en griego es kapnos (καπνός, por el humo)\nmuralis: epíteto latino que significa \"que crece en los muros\".","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Fumaria_muralis"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"anual","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:673038-1"},{"grupo":"Forma de vida","k":"Clima","v":"templado","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:673038-1"},{"grupo":"Genética","k":"Número cromosomático","v":"2n = 28, 48","fuente":"CCDB","url":"https://ccdb.tau.ac.il/search/?genus=Fumaria"}],"altitud":{"p5":40,"p95":1370,"min":10,"max":1620,"n":60,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?taxon_key=7315286&geometry=POLYGON((-18.5 27.4,-13.2 27.4,-13.2 29.5,-18.5 29.5,-18.5 27.4))"}}