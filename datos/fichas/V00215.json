Caza menor","definicion":"Especie objeto de caza menor"},"La Palma":{"categoria":"Caza menor","definicion":"Especie objeto de caza menor"},"Tenerife":{"categoria":"Caza menor","definicion":"Especie objeto de caza menor"}}},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":2436940,"uicn":{"codigo":"EN","categoria":"En peligro","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/2436940","iucnId":"41291"},"tamano":{"min":null,"max":0.5,"tipo":"longitud","cita":"Mide hasta 50 cm y su masa puede ser hasta 2.5 kg","fuente":"Wikipedia (es)","url":"https://es.wikipedia.org/wiki/Oryctolagus_cuniculus"},"peso":{"kg":1.8,"tipo":"adulto","fuente":"AnAge","url":"https://genomics.senescence.info/species/entry.php?species=Oryctolagus_cuniculus"},"longevidad":{"anos":13.0,"tipo":"máxima registrada","origen":"en cautividad","fuente":"AnAge","url":"https://genomics.senescence.info/species/entry.php?species=Oryctolagus_cuniculus"},"forma":{"valor":"mamifero","fuente":"Grupo y familia"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Oryctolagus cuniculus Tasmania 2 (cropped).jpg","autor":"JJ Harrison","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","pagina":"https://commons.wikimedia.org/wiki/File:Oryctolagus_cuniculus_Tasmania_2_(cropped).jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/520690657/medium.jpg","autor":"jitensha2021","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/520690657","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/476638558/medium.jpg","autor":"Caiden","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/476638558","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/137362674/medium.jpg","autor":"Alexis Lours","lic":"CC BY","licUrl":"https://creativecommons.org/licenses/by/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/137362674","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/529217699/medium.jpg","autor":"jirau","lic":"CC BY-SA","licUrl":"https://creativecommons.org/licenses/by-sa/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/529217699","nivel":"taxon"}],"etimologia":{"texto":"El término orycto viene del griego ορυκτός (oriktós ‘[ex]cavado, desenterrado’) y este de ορύσσειν (orýssein ‘cavar’), en referencia a las costumbres excavadoras características de esta especie en estado salvaje, mientras que el término griego λαγός (lagos) significa estrictamente ‘liebre’.\nPara descubrir el origen del nombre de la especie, así como de su nombre común, hay que remontarse hasta algunos siglos antes de Cristo. El conejo era un animal desconocido para los griegos y romanos de la Antigüedad que visitaron la península ibérica. El historiador griego Polibio (siglo II a. C.) lo describe por primera vez. Su nombre vernáculo, conejo, proviene del término íbero (o «prerromano», según el Diccionario de la lengua española) kóniklos (κόνικλoς), que después derivó al término latino cuniculus, y al español conejo.","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Oryctolagus_cuniculus"},"rasgos":[{"grupo":"Reproducción","k":"Madurez sexual","v":"2 años","fuente":"AnAge","url":"https://genomics.senescence.info/species/entry.php?species=Oryctolagus_cuniculus"},{"grupo":"Reproducción","k":"Gestación","v":"30 días","fuente":"AnAge","url":"https://genomics.senescence.info/species/entry.php?species=Oryctolagus_cuniculus"},{"grupo":"Reproducción","k":"Crías por parto","v":"5","fuente":"AnAge","url":"https://genomics.senescence.info/species/entry.php?species=Oryctolagus_cuniculus"},{"grupo":"Reproducción","k":"Puestas o partos al año","v":"4,3","fuente":"AnAge","url":"https://genomics.senescence.info/species/entry.php?species=Oryctolagus_cuniculus"},{"grupo":"Reproducción","k":"Peso al nacer o eclosionar","v":"45 g","fuente":"AnAge","url":"https://genomics.senescence.info/species/entry.php?species=Oryctolagus_cuniculus"},{"grupo":"Alimentación","k":"Dieta","v":"otras partes de plantas 100 %","fuente":"EltonTraits","url":"https://doi.org/10.1890/13-1917.1"},{"grupo":"Alimentación","k":"Dónde busca el alimento","v":"en el suelo","fuente":"EltonTraits","url":"https://doi.org/10.1890/13-1917.1"},{"grupo":"Ecología","k":"Actividad","v":"nocturna","fuente":"EltonTraits","url":"https://doi.org/10.1890/13-1917.1"}],"introduccion":{"fecha":"A partir del siglo XV (De Abreu-Galindo, 1977).","via":"Ha sido introducido con fines cinegéticos y como complemento alimenticio.","ano":"2008","pagina":1543,"nombre":"Oryctolagus cuniculus","fuente":"Compendio de fichas de la Base de especies introducidas en Canarias (2008-2011), Gobierno de Canarias","url":"https://www.gobiernodecanarias.org/medioambiente/descargas/publicaciones/GOBCAN-2022-Compendio-fichas-especies-introducidas-2008-2011.zip"},"altitud":{"p5":10,"p95":2250,"min":0,"max":2470,"n":253,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?taxon_key=2436940&geometry=POLYGON((-18.5 27.4,-13.2 27.4,-13.2 29.5,-18.5 29.5,-18.5 27.4))"},"primerRegistro":{"ano":1993,"tipo":"observación","url":"https://www.gbif.org/occurrence/4149099735","fuente":"GBIF"},"sonidos":[{"url":"https://xeno-canto.org/960435/download","autor":"Simon Elliott","lic":"CC BY-NC-ND 4.0","licUrl":"https://creativecommons.org/licenses/by-nc-nd/4.0/","pagina":"https://xeno-canto.org/960435","fuente":"xeno-canto","tipo":"call, thump","lugar":"Hessay, York, England, United Kingdom","canarias":false},{"url":"https://xeno-canto.org/960434/download","autor":"Simon Elliott","lic":"CC BY-NC-ND 4.0","licUrl":"https://