{"codigo":"F00115","nombre":"Nigella damascena","autor":"L.","rango":"especie","nombreCompleto":"Nigella damascena L.","comunes":["Arañuela"],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Magnoliopsida","validez":"Válido","status":"Actual","presencia":{"P":"s","G":"s","T":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":3,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F00115"},"imagenes":[{"id":"209125811","autor":"","licencia":"","documento":"P00202","portada":false,"descripcion":"","credito":"Rodríguez Luengo, J. L., 2021"},{"id":"209125812","autor":"","licencia":"","documento":"P00202","portada":false,"descripcion":"","credito":"Rodríguez Luengo, J. L., 2021"},{"id":"209125813","autor":"","licencia":"","documento":"P00202","portada":false,"descripcion":"","credito":"Rodríguez Luengo, J. L., 2021"}],"mapaPk":"11154","comunTitulo":"Arañuela","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":null,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"F01114"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Ranunculales","Familia":"Ranunculaceae","Género":"Nigella"},"sinonimos":0,"referencias"