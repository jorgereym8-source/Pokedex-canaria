 grandes (Bañares, A. et al., 2004, Bramwell D. & Z. Bramwell, 1991)"},"pdf":true},"nivel":"insular","actualizado":"2026-11-21","uicn":{"codigo":"CR","categoria":"En peligro crítico","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/3094889","iucnId":"162150"},"gbifClave":3094889,"ciclo":{"valor":"Perenne","fuente":"Centinela"},"forma":{"valor":"hierba","fuente":"Centinela"}}