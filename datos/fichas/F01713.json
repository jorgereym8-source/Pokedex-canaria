/3.0","pagina":"https://commons.wikimedia.org/wiki/File:Barba_cabra_flor-1.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/500683469/medium.jpeg","autor":"columbidaeperson","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/500683469","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/298145572/medium.jpg","autor":"Robert Levy","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/298145572","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/180639530/medium.jpg","autor":"Gideon van Melle","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/180639530","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/282164061/medium.jpeg","autor":"Valerio Lazzeri","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/282164061","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/nativas/tragopogon-porrifolius","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["suroeste de Europa","sureste de Europa","este de Europa","norte de África","Macaronesia","oeste de Asia","península arábiga"],"introducida":["norte de Europa","centro de Europa","África tropical nororiental","sur de África","Asia oriental","subcontinente indio","Indochina","Australia","Nueva Zelanda","Pacífico centro-norte","oeste de Canadá","este de Canadá","noroeste de EE. UU.","centro-norte de EE. UU.","noreste de EE. UU.","suroeste de EE. UU.","centro-sur de EE. UU.","sureste de EE. UU.","México"],"nAreasNativa":25,"nAreasIntroducida":74,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:256109-1","nivel":"taxon","nombre":null},"etimologia":{"texto":"Tragopogon: prestado del latín trǎgŏpōgōn, -ōnis, vocablo derivado directamente del griego τραγοπώγων y compuesto por los vocablos τράγοζ, -ου, cabra, chivo, y πώγων, -ώνος, barba; o sea «barba de chivo», por el penacho de pelos plumosos blancos del vilano que sobresalen en el ápice de las inflorescencias, casi siempre cerradas, y que se asemejan a la barbilla del macho cabrío. Empleado por Plinio el Viejo en su Naturalis Historia (27, 142) con el mismo significado y que lo considera sin la menor utilidad.\nporrifolius: del latín porrum, -i, el puerro y folǐum, -ǐi, hoja; o sea  «con hojas de puerro».\nEs la especie tipo del género Tragopogon; su lectotipo fue designado en 1992 por Consuelo Díaz de Guardia y Gabriel Blanca a partir de un ejemplar del Herbario de Joachim Burser (1583-1639) conservado en la Universidad de Uppsala (Suecia), debido a que el espécimen del herbario del propio Linneo no es válido para conservarlo como tipo.\nSubespecies aceptadas\nTragopogon porrifolius subsp. australis (Jord.) Nyman\nTragopogon porrifolius subsp. cupani (Guss. ex DC.) I.Richardson\nTragopogon porrifolius subsp. eriospermus (Ten.) Greuter]\nTragopogon porrifolius subsp. longirostris (Sch.Bip.) G","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Tragopogon_porrifolius"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"bienal","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:256109-1"},{"grupo":"Forma de vida","k":"Clima","v":"templado","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:256109-1"}],"altitud":{"p5":410,"p95":1900,"min":30,"max":2290,"n":159,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?taxon_key=5386938&geometry=POLYGON((-18.5 27.4,-13.2 27.4,-13.2 29.5,-18.5 29.5,-18.5 27.4))"}}