:false,"descripcion":""},{"id":"124225159","autor":"","licencia":"","documento":"D02693","portada":false,"descripcion":""},{"id":"124225160","autor":"","licencia":"","documento":"D02693","portada":false,"descripcion":""},{"id":"246644758","autor":"","licencia":"","documento":"P01537","portada":false,"descripcion":""}],"mapaPk":"9876","comunTitulo":"Bencomia herreña","endemicidad":{"canarias":{"género":false,"especie":true,"subespecie":null},"macaronesia":{"género":true,"especie":true,"subespecie":null}},"origen":{"nombre":"Nativo Seguro","codigo":"NS","definicion":"Incluye taxones nativos, tanto endémicos como no endémicos. En ambos casos esta categoría será asignada a aquellos taxones de los que se tiene constancia o se intuye que su presencia en Canarias es natural y no asociada a la actividad humana.","documento":"F01114"},"habitats":[{"categoria":"Monteverde arbóreo","documento":"F00022"},{"categoria":"Brezal-fayal","documento":"F00039"}],"protegida":true,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Magnoliopsida","Orden":"Rosales","Familia":"Rosaceae","Género":"Bencomia"},"sinonimos":0,"referencias":60,"proteccion":{"Catálogo Español/LESRPE":{"El Hierro":{"categoria":"En peligro de extinción","definicion":"Taxones o poblaciones cuya superviviencia es poco probable si los factores causales de su actual situación siguen actuando."}},"Directiva Hábitat":{"El Hierro":{"categoria":"Anexo II y IV","definicion":"Especies que se encuentran incluidas en ambas categorías. Según el Anexo II, son especies cuyos hábitats requieren designación de ZEC; y según el Anexo IV: son especies que requieren protección estricta."}},"Catálogo Canario":{"El Hierro":{"categoria":"En peligro de extinción","definicion":"Especies \"en peligro de extinción\", que serán, aparte de aquellas con presencia significativa en Canarias y así calificadas por el Catálogo Español de Especies Amenazadas, las que se incorporen de acuerdo con lo previsto en la presente ley o figuren en su anexo I, constituidas por taxones o poblaciones cuya supervivencia es poco probable si los factores causales de su actual situación siguen actuando."}},"Convenio de Berna":{"El Hierro":{"categoria":"Anejo I","definicion":"Especies de flora estrictamente protegida"}}},"enlaces":[{"titulo":"Planes de Recuperación y/o Conservación","url":"http://www.gobcan.es/boc/2009/071/004.html"},{"titulo":"Sexenal 2001-2006","url":"http://cdr.eionet.europa.eu/Converters/run_conversion?file=/es/eu/art17/envshhaew/species-bencomia-sphaerocarpa.xml&conv=24&source=remote#MAC"},{"titulo":"Sexenal 2007-2012","url":"http://cdr.eionet.europa.eu/Converters/run_conversion?file=/es/eu/art17/envucgusw/ES_species_reports-13910-125043.xml&conv=354&source=remote#1536"},{"titulo":"Sexenal 2013-2018","url":"https://cdr.eionet.europa.eu/Converters/run_conversion?file=es/eu/art17/envxrm14a/ES_species_reports-20190723-144539.xml&conv=593&source=remote#1536"},{"titulo":"Ministerio de Transición Ecológica. Libros Rojos","url":"http://www.magrama.gob.es/es/biodiversidad/temas/inventarios-nacionales/1101_tcm7-149641.pdf"},{"titulo":"UICN. Unión Internacional para la Conservación de la Naturaleza","url":"http://www.iucnredlist.org/details/162117/0"},{"titulo":"GBIF-España. Global Biodiversity Information Facility","url":"http://www.gbif.org/species/3032179"}],"uicnId":"162117","gbifId":"3032179","centinela":{"secciones":{"Distribución mundial":"Endemismo canario.","Distribución en Canarias":"Norte de El Hierro.","Origen":"Nativo Seguro (NS)","Hábitat":"Laderas orientadas al norte y al noroeste de la vertiente norte de la isla, entre las cotas de 850 a 1.250 m y en zonas afectadas por los alisios y las nubes, y por encima del área potencial del bosque termoesclerófilo (aunque dentro de esta franja altitudinal su área potencial se reduce a la presencia de suelos sálicos, ya que éstos favorecen el desarrollo de pinares mixtos de monteverde). La subpoblación de la fuente de Tinco se integra en la comunidad de monteverde seco correspondiente con los bosques y arbustedas naturales de monteverde. Por otro lado, las subpoblaciones de Fileba y Tábano forman parte de los matorrales de sustitución que conforman la comunidad de fayal-brezal (Silva Armas, J.L., 2016).","Claves de identificación":"Arbusto de 2 a 4 m. de altura, que se mantiene siempre verde. La corteza de los troncos viejos adquiere aspecto de escama. Ramas jóvenes pelosas. Hojas agrupadas en rosetas al final de las ramas, compuestas (de 5 a 8 pares de “hojitas”), de color verde con pecíolo densamente peloso y con estípulas (pequeños apéndices en forma de láminas a cada lado de la base de la hoja) en la base. Inflorescencias en forma de espiga con flores pequeñas, menores las femeninas, siendo la masculina péndula y la femenina, erecta. Se diferencia de B. caudata por las brácteas florales, ya que en B. sphaerocarpa la mediana está largamente terminada en punta (Bello, P., 2010)."},"pdf":true},"nivel":"insular","actualizado":"2026-11-21","gbifClave":3032179,"uicn":{"codigo":"CR","categoria":"En peligro crítico","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/3032179","iucnId":"162117"},"tamano":{"min":2.0,"max":4.0,"tipo":"altura","cita":"Arbusto de 2 a 4 m","fuente":"Centinela (claves de identificación)","url":"https://www.biodiversidadcanarias.es/centinela/especie/F00436"},"ciclo":{"valor":"Perenne","fuente":"Centinela"},"forma":{"valor":"arbusto","fuente":"Centinela"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Bencomia sphaerocarpa.jpg","autor":"James Steakley","lic":"CC BY-SA 3.0","licUrl":"https://creativecommons.org/licenses/by-sa/3.0","pagina":"https://commons.wikimedia.org/wiki/File:Bencomia_sphaerocarpa.jpg","nivel":"taxon"},{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amazonaws.com/photos/67417648/medium.jpeg","autor":"Sylvain Piry","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/67417648","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/endemicas/hierro/bencomia-sphaerocarpa","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["Canarias"],"introducida":[],"nAreasNativa":1,"nAreasIntroducida":0,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:721781-1","nivel":"taxon","nombre":null},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"arbusto","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:721781-1"},{"grupo":"Forma de vida","k":"Clima","v":"subtropical","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:721781-1"}],"natura2000":{"espacios":[{"codigo":"ES7020099","nombre":"Frontera","tipo":"B"}],"fuente":"Agencia Europea de Medio Ambiente · Natura 2000 (end 2024 rev. 1)","url":"https://natura2000.eea.europa.eu/"},"art17":{"ambito":"España, región macaronésica","estado":"desfavorable-malo","tendencia":"empeorando","parametros":{"range":"favorable","population":"desfavorable-malo","habitat":"favorable","future":"desfavorable-inadecuado"},"periodo":"2013-2018","fuente":"Informe del artículo 17 de la Directiva Hábitats (EEA)","url":"https://nature-art17.eionet.europa.eu/article17/species/summary/"},"altitud":{"p5":770,"p95":1280,"min":760,"max":1310,"n":5,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?taxon_key=3032179&geometry=POLYGON((-18.5 27.4,-13.2 27.4,-13.2 29.5,-18.5 29.5,-18.5 27.4))"}}