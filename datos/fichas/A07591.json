{"codigo":"A07591","nombre":"Trioza erytreae","autor":"(Del Guercio, 1918)","rango":"especie","nombreCompleto":"Trioza erytreae (Del Guercio, 1918)","comunes":["Psila africana de los cítricos"],"reino":"Fauna","grupo":"Insectos","subgrupo":"Hemípteros","medio":"Terrestre","clase":"Hexapoda","validez":"Válido","status":"Actual","presencia":{"T":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/A07591"},"imagenes":[],"mapaPk":"8978","comunTitulo":"Psila africana de los cítricos","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":false,"especie":false,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"A02155"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Metazoa","Filo":"Arthropoda","Clase":"Hexapoda","Orden":"Hemiptera","Familia":"Triozidae","Género":"Trioza"},"sinonimos":0,"referencias":9,"proteccion":{},"enlaces":[],"actualizado":"2026-11-22","nivel":"introducido","gbifClave":5153544,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/5153544","iucnId":null},"forma":{"valor":"escarabajo","fuente":"Grupo y familia"},"fotosLibres":[{"fuente":"iNaturalist","url":"https://inaturalist-open-data.s3.amaz