{"codigo":"A07133","nombre":"Myzus cerasi cerasi","autor":"(Fabricius, 1775)","rango":"especie","nombreCompleto":"Myzus cerasi cerasi (Fabricius, 1775)","comunes":[],"reino":"Fauna","grupo":"Insectos","subgrupo":"Hemípteros","medio":"Terrestre","clase":"Hexapoda","validez":"Válido","status":"Actual","presencia":{"T":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/A07133"},"imagenes":[],"mapaPk":"1611","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":false},"macaronesia":{"género":null,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"D03257"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Metazoa","Filo":"Arthropoda","Clase":"Hexapoda","Orden":"Hemiptera","Familia":"Aphididae","Género":"Myzus","Especie":"Myzus cerasi (Fabricius, 1775)"},"sinonimos":0,"referencias":7,"proteccion":{},"enlaces":[],"actualizado":"2026-11-22","nivel":"introducido","gbifClave":7199228,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/7199228","iucnId":null},"forma":{"valor":"escarabajo","fuente":"Grupo y familia"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Aleyrodoidea en Bastavales, Brión, Galicia.jpg","autor":"Luis