{"codigo":"F01760","nombre":"Allium nigrum","autor":"L.","rango":"especie","nombreCompleto":"Allium nigrum L.","comunes":["Ajo negro"],"reino":"Flora","grupo":"Plantas con flor","subgrupo":"Terrestres","medio":"Terrestre","clase":"Liliopsida","validez":"Válido","status":"Actual","presencia":{"T":"s","C":"s"},"origenCsv":"IP","endemicoCsv":false,"nImagenes":0,"fuentes":{"lista":"Biota (exportación oficial)","ficha":"https://www.biodiversidadcanarias.es/biota/especie/F01760"},"imagenes":[],"mapaPk":"11201","comunTitulo":"Ajo negro","endemicidad":{"canarias":{"género":false,"especie":false,"subespecie":null},"macaronesia":{"género":false,"especie":null,"subespecie":null}},"origen":{"nombre":"Introducido Probable","codigo":"IP","definicion":"Incluye aquellos taxones en los que existen indicios que señalan la dificultad de que su presencia en Canarias se deba a procesos naturales no asociados al hombre. Son taxones no reconocidos como introducidos en las fuentes bibliográficas, pero con una asociación clara con ambientes antrópicos. Incluye también aquellos taxones que se intuye son introducidos en Canarias por ser invasores en otros lugares fuera del archipiélago, por su amplia distribución en las islas y fuera de ellas, o por tener formas de dispersión natural vinculadas al hombre.","documento":"F01114"},"habitats":[],"protegida":false,"taxonomia":{"Reino":"Plantae","División":"Spermatophyta","Subdivisión":"Magnoliophytina","Clase":"Liliopsida","Orden":"Asparagales","Familia":"Amaryllidaceae","Género":"Allium"},"sinonimos":1,"referencias":10,"proteccion":{},"enlaces":[],"nivel":"introducido","actualizado":"2026-11-21","gbifClave":2855823,"uicn":{"codigo":"NE","categoria":"No evaluada","nivel":"taxón","fuente":"Lista Roja de la UICN (versión 2022-2) vía GBIF","url":"https://www.gbif.org/species/2855823","iucnId":null},"forma":{"valor":"hierba","fuente":"Wikipedia (es)"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"00 7777 Allium nigrum - Schwarzer Lauch.jpg",