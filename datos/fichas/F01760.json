a \"de color negro\".","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Allium_nigrum"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"bulboso geófito","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:528486-1"},{"grupo":"Forma de vida","k":"Clima","v":"templado","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:528486-1"}]}