18"},"ciclo":{"valor":"Perenne","fuente":"Centinela"},"forma":{"valor":"trepadora","fuente":"Wikipedia (es)"},"fotosLibres":[{"fuente":"Wikimedia Commons","archivo":"Isoplexis isabelliana0.jpg","autor":"Autor en Wikimedia Commons","lic":"CC BY-SA 3.0","licUrl":"http://creativecommons.org/licenses/by-sa/3.0/","pagina":"https://commons.wikimedia.org/wiki/File:Isoplexis_isabelliana0.jpg","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/allcategories-es-es/endemicas/gran-canaria/isoplexis-isabelliana","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"}}