ps://inaturalist-open-data.s3.amazonaws.com/photos/178684859/medium.jpg","autor":"rf222","lic":"CC BY-NC","licUrl":"https://creativecommons.org/licenses/by-nc/4.0/deed.es","pagina":"https://www.inaturalist.org/photos/178684859","nivel":"taxon"}],"evc":{"url":"https://endemicascanarias.com/es/orquideas/orchis-mascula","titulo":"Especies Vegetales en Canarias","autoria":"Gerardo G. Casanova y colaboradores"},"mundo":{"nativa":["norte de Europa","centro de Europa","suroeste de Europa","sureste de Europa","este de Europa","norte de África","Macaronesia","Cáucaso","oeste de Asia"],"introducida":[],"nAreasNativa":48,"nAreasIntroducida":0,"fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:648853-1","nivel":"taxon","nombre":null},"etimologia":{"texto":"Estas  orquídeas reciben su nombre del griego όρχις \"orchis\", que significa testículo, por la apariencia de los tubérculos subterráneos en algunas especies terrestres. La palabra 'orchis' la usó por primera vez  Teofrasto (371/372 - 287/286 a. C.), en su libro  \"De historia plantarum\" (La historia natural de las plantas). Fue discípulo de Aristóteles y está considerado como el padre de la Botánica y de la Ecología.\nmascula: epíteto latino que significa macho, masculino.","fuente":"Wikipedia en español","url":"https://es.wikipedia.org/wiki/Orchis_mascula"},"rasgos":[{"grupo":"Forma de vida","k":"Forma vital","v":"tuberoso geófito","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:648853-1"},{"grupo":"Forma de vida","k":"Clima","v":"templado","fuente":"WCVP (Kew)","url":"https://powo.science.kew.org/taxon/urn:lsid:ipni.org:names:648853-1"},{"grupo":"Genética","k":"Número cromosomático","v":"2n = 42","fuente":"CCDB","url":"https://ccdb.tau.ac.il/search/?genus=Orchis"}],"altitud":{"p5":830,"p95":1790,"min":830,"max":1790,"n":9,"fuente":"Registros de GBIF en Canarias y modelo del terreno Copernicus GLO-90","url":"https://www.gbif.org/occurrence/search?